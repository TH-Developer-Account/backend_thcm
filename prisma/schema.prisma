// ─────────────────────────────────────────────
// CRF × SHOPIFY (SOUVENIRS) ENUMS
//
// Added for the CRF souvenir fulfilment feature — see
// claude/decisions-and-learnings.md for the full design discussion.
// ─────────────────────────────────────────────

enum CrfStatus {
  OPEN                // editable while EPC is draft/clarification
  APPROVED            // EPC approved, stock confirmed, awaiting recipient/address + Place order
  STOCK_SHORTFALL     // EPC approved, some souvenir lines short — proposer must swap or accept partial
  STOCK_CHECK_FAILED  // EPC approved, but the post-approval Shopify stock check couldn't reach the
                      // store (THCM Shop down/unreachable) — never got to APPROVED/STOCK_SHORTFALL.
                      // Owner or admin can retry the check once the store is back (see
                      // crfOrder.service.ts's retryStockCheck). Distinct from ORDER_FAILED below:
                      // this is a failure to CHECK stock, not a failure to PLACE an already-confirmed order.
  ORDER_FAILED        // Create Order call failed (address/integration) — admin can retry
  ORDERED             // Shopify order placed
  CANCELLED           // EPC rejected, or order cancelled
  CLOSED              // ORDERED + every manual (printed material/artwork) line delivered
}

enum CrfRecipientType {
  SELF
  EMPLOYEE
  DEALER_CONTACT
  OTHER
}

enum CrfAddressSource {
  MANUAL
  USER_PROFILE
  BUSINESS_PARTNER_ADDRESS
}

enum CrfItemSource {
  CATALOG   // internal ProductMaster — printed material / artwork
  SHOPIFY   // live Shopify catalog — souvenirs
}

enum CrfItemStatus {
  REQUESTED      // part of current order intent
  OUT_OF_STOCK   // short at last check, proposer must decide
  REMOVED        // proposer manually dropped it (swap)
  ORDERED        // included in the placed Shopify order
  DEBITED        // dropped via accept-partial; its value is in CrfOrder.debitNoteAmount
}

enum CrfOrderStatus {
  ACTIVE
  CANCELLED
}

// ─────────────────────────────────────────────
// AUTH MODELS
// ─────────────────────────────────────────────

model User {
  id                    String               @id @default(uuid())
  first_name            String               @db.VarChar(50)
  last_name             String               @db.VarChar(50)
  email                 String?              @unique @db.VarChar(100)   // was: String @unique
  phone_number          String?              @unique @db.VarChar(15)    // was: String @unique
  password              String               @db.VarChar(255)
  is_active             Boolean              @default(true)
  is_default_login      Boolean              @default(true)

  // ── HR / org master fields (new) ──────────────────────────────────────
  employeeCode     String?
  bydId            String?
  s4Id             String?
  tallyId          String?
  c4cId            String?
  address          String?
  branchId         String?
  branch           Branch?       @relation(fields: [branchId], references: [id])
  department       String?
  role             String?
  vertical         String?
  managerCode1     String?
  managerCode2     String?

  // ── HR org fields ──────────────────────────────────────────────────────
  // location: what the old `region` column actually held — EOR's
  // "Location" column (plant/city). Plain free text, deliberately NOT a
  // master-backed FK (unlike designation/division/costCenter below) —
  // real-world location values vary too much to constrain to a fixed
  // list; see decisions-and-learnings.md.
  location      String?
  designationId String?
  designation   Designation?  @relation(fields: [designationId], references: [id])
  divisionId    String?
  division      Division?     @relation(fields: [divisionId], references: [id])
  costCenterId  String?
  costCenter    CostCenter?   @relation(fields: [costCenterId], references: [id])
  // zones: many-to-many — one user (e.g. a regional manager) can cover
  // more than one zone. Zone is also EventProposal's former "Region"
  // master, unified into one table since the two concepts are the same
  // thing (see the Zone model below).
  zones         Zone[]
  isDefaultContact Boolean             @default(false)
  userType         String? // reuses the existing THCM/DEALER/CUSTOMER enum — nullable since not every User is one of these
  joinedOn         DateTime?
  grade            String?

  // Dealer users only — links to the Company code on the source row,
  // matched against BusinessPartner.internalId. Null for THCM/other users.
  businessPartnerId String?
  businessPartner   BusinessPartner? @relation(fields: [businessPartnerId], references: [id])

  // ── existing relations below, unchanged ─────────────────────────────
  refresh_tokens        RefreshToken[]
  password_reset_tokens PasswordResetToken[]
  workspaceUsers WorkspaceUser[]
  userProfiles         UserProfile[]      @relation("UserProfileHolder")
  assignedUserProfiles UserProfile[]      @relation("UserProfileAssigner")
  administeredApps         AppAdministrator[] @relation("AdministeredApps")
  grantedAppAdministrators AppAdministrator[] @relation("GrantedAppAdministrators")
  notifications     Notification[]
  pushSubscriptions PushSubscription[]
  created_event_proposals EventProposal[] @relation("EventCreatedBy")
  updated_event_proposals EventProposal[] @relation("EventUpdatedBy")
  created_workflow WorkflowTemplate[] @relation("WorkFlowCreatedBy")
  updated_workflow WorkflowTemplate[] @relation("WorkFlowUpdatedBy")
  initiated_vendor_onboardings VendorOnboarding[] @relation("VendorOnboardingInitiatedBy")
  initiated_medical_claims MedicalClaim[] @relation("MedicalClaimInitiatedBy")
  approvals         Approval[]
  templateApprovals TemplateApprover[]
  workFlowUsers     WorkFlowTemplateUser[]
  comments          Comment[]
  reportValidations EventReport[] @relation("ReportValidator")
  activityLogs   ActivityLog[]
  importExportLogs ImportExportLog[]
  businessPartnerContact BusinessPartnerContact[]

  // ── CRF × Shopify (souvenirs) ────────────────────────────────────────
  createdCrfs     CRF[] @relation("CrfCreatedBy")
  crfsAsRecipient CRF[] @relation("CrfRecipientUser")

  created_at DateTime @default(now()) @db.Timestamp(6)
  updated_at DateTime @default(now()) @db.Timestamp(6)

  @@index([employeeCode, userType])
  @@index([businessPartnerId])
}

model PasswordResetToken {
  id         String   @id @default(uuid())
  user_id    String
  user       User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  token      String   @unique @db.VarChar(255)
  expires_at DateTime
  used       Boolean  @default(false)
  created_at DateTime @default(now())
}

model RefreshToken {
  id         String   @id @default(uuid())
  token_id   String   @unique @db.VarChar(36)
  token_hash String   @db.VarChar(255)
  token      String   @unique
  user_id    String
  user       User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  user_agent String?
  ip_address String?
  revoked    Boolean  @default(false)
  expires_at DateTime
  created_at DateTime @default(now())
}

model DailyVisitors {
  id           String   @id @default(uuid())
  date         DateTime @unique @db.Date
  total_visits Int      @default(0)
  created_at   DateTime @default(now())

  @@index([date])
}

// ─────────────────────────────────────────────
// WORKSPACE
// ─────────────────────────────────────────────

model Workspace {
  id   String @id @default(uuid())
  name String

  users             WorkspaceUser[]
  apps              WorkspaceApp[]
  profiles          Profile[]
  userProfiles      UserProfile[]
  appAdministrators AppAdministrator[]
  vendorOnboardings VendorOnboarding[]
  medicalClaims MedicalClaim[]

  workflowTemplates WorkflowTemplate[]
  workflows         WorkflowInstance[]
  importExportLogs  ImportExportLog[]
  notifications Notification[]

  created_at DateTime @default(now()) @db.Timestamp(6)
  updated_at DateTime @default(now()) @db.Timestamp(6)
}

model WorkspaceUser {
  userId       String
  workspaceId  String
  isSuperAdmin Boolean  @default(false)
  joinedAt     DateTime @default(now())

  user      User      @relation(fields: [userId], references: [id])
  workspace Workspace @relation(fields: [workspaceId], references: [id])

  @@id([userId, workspaceId])
  @@index([workspaceId])
}

// ─────────────────────────────────────────────
// APP + MODULE
// ─────────────────────────────────────────────

model App {
  id   String @id @default(uuid())
  key  String @unique
  name String

  workspaceApps     WorkspaceApp[]
  modules           Module[]
  workFlowTemplate  WorkflowTemplate[]
  profiles          Profile[]
  appAdministrators AppAdministrator[]

  created_at DateTime @default(now())
  updated_at DateTime @default(now())
}

model WorkspaceApp {
  workspaceId String
  appId       String
  enabled     Boolean  @default(true)
  enabledAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id])
  app       App       @relation(fields: [appId], references: [id])

  @@id([workspaceId, appId])
  @@index([workspaceId])
}

model Module {
  id         String   @id @default(uuid())
  key        String
  name       String
  appId      String
  created_at DateTime @default(now()) @db.Timestamp(6)
  updated_at DateTime @default(now()) @db.Timestamp(6)

  app                App                 @relation(fields: [appId], references: [id])
  profilePermissions ProfilePermission[]

  @@unique([appId, key])
}

// ─────────────────────────────────────────────
// ACCESS CONTROL
//
// Three separate concepts, each with its own storage:
//   - Administrative scope → AppAdministrator (granted by Super Admin only)
//   - What a user can do   → Profile + ProfilePermission (one app per profile)
//   - Application access   → derived: a UserProfile slot for that app exists
//
// See claude/access-control-spec.md for the full rule set.
// ─────────────────────────────────────────────

// Admin rights are not a permission inside a profile: keeping them in their
// own table means no profile edit or assignment can ever grant or revoke them.
model AppAdministrator {
  workspaceId String
  userId      String
  appId       String
  grantedById String
  grantedAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id])
  user      User      @relation("AdministeredApps", fields: [userId], references: [id])
  app       App       @relation(fields: [appId], references: [id])
  grantedBy User      @relation("GrantedAppAdministrators", fields: [grantedById], references: [id])

  @@id([workspaceId, userId, appId])
  @@index([workspaceId, appId])
}

model Profile {
  id              String   @id @default(uuid())
  name            String
  description     String?
  workspaceId     String
  appId           String
  isSystemProfile Boolean  @default(false)
  created_at      DateTime @default(now()) @db.Timestamp(6)
  updated_at      DateTime @default(now()) @db.Timestamp(6)

  workspace    Workspace           @relation(fields: [workspaceId], references: [id])
  app          App                 @relation(fields: [appId], references: [id])
  permissions  ProfilePermission[]
  userProfiles UserProfile[]

  @@unique([workspaceId, appId, name])
  // Target of UserProfile's composite relation, so Postgres rejects a profile
  // stored in another app's slot.
  @@unique([id, appId])
  @@index([workspaceId, appId])
}

model ProfilePermission {
  id        String           @id @default(uuid())
  profileId String
  moduleId  String
  action    PermissionAction

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  module  Module  @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  @@unique([profileId, moduleId, action])
}

// One row per (user, app): assigning a profile upserts this slot, so a
// profile in one app can never overwrite or remove access to another app.
model UserProfile {
  userId       String
  workspaceId  String
  appId        String
  profileId    String
  assignedById String?
  assignedAt   DateTime @default(now())

  user       User      @relation("UserProfileHolder", fields: [userId], references: [id])
  assignedBy User?     @relation("UserProfileAssigner", fields: [assignedById], references: [id])
  workspace  Workspace @relation(fields: [workspaceId], references: [id])
  profile    Profile   @relation(fields: [profileId, appId], references: [id, appId])

  @@id([userId, workspaceId, appId])
  @@index([workspaceId, profileId])
}

// ─────────────────────────────────────────────
// BUSINESS DATA
// ─────────────────────────────────────────────

model EventProposal {
  id                String   @id @default(uuid())
  proposal_number   String   @unique
  event_from_date   DateTime
  event_to_date     DateTime
  event_description String
  location          String
  event_objective   String
  status            String   @default("PENDING")

  created_by_id    String
  updated_by_id    String
  department_id    String
  region_id        String
  branch_id        String
  event_scale      Int
  budget_master_id String
  event_name_id    String
  vertical_id      String
  deviationReason String?
  deviationAmount Decimal? @db.Decimal(12, 2)
  deviationDocUrl String?
  deviationDocS3Key String?
  locationMeta     Json?

  department    Department   @relation(fields: [department_id], references: [id])
  vertical      Vertical     @relation(fields: [vertical_id], references: [id])
  region        Zone         @relation(fields: [region_id], references: [id])
  branch        Branch       @relation(fields: [branch_id], references: [id])
  budget_master BudgetMaster @relation(fields: [budget_master_id], references: [id])
  event_name    EventName    @relation(fields: [event_name_id], references: [id])
  created_by    User         @relation("EventCreatedBy", fields: [created_by_id], references: [id])
  updated_by    User         @relation("EventUpdatedBy", fields: [updated_by_id], references: [id])

  epf EPF?
  crf CRF?
  report EventReport?

  leads     Lead[]
  importExportLogs ImportExportLog[]
  machineStudies MachineStudy[]

  search_vector Unsupported("tsvector")?
  created_at    DateTime                 @default(now())
  updated_at    DateTime                 @updatedAt
}

// ─────────────────────────────────────────────
// WORKFLOW TEMPLATE SYSTEM
// ─────────────────────────────────────────────

model WorkflowTemplate {
  id          String  @id @default(uuid())
  name        String
  description String

  workspaceId String
  isActive    Boolean @default(true)
  appId       String
  ownerType  TemplateOwnerType @default(ADMIN)
  isReusable Boolean           @default(true)
  metaData_1  String
  metaData_2  String
  metaData_3  String

  created_by_id String
  updated_by_id String
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt

  stages            TemplateStage[]
  workflowInstances WorkflowInstance[]
  workFlowUsers     WorkFlowTemplateUser[]

  app        App              @relation(fields: [appId], references: [id])
  workspace  Workspace        @relation(fields: [workspaceId], references: [id])
  created_by User             @relation("WorkFlowCreatedBy", fields: [created_by_id], references: [id])
  updated_by User             @relation("WorkFlowUpdatedBy", fields: [updated_by_id], references: [id])

  @@index([ownerType])
  @@index([isReusable])
}

model TemplateStage {
  id           String       @id @default(uuid())
  name         String
  templateId   String
  stageOrder   Int
  strategy     StrategyType
  minApprovals Int?

  template  WorkflowTemplate  @relation(fields: [templateId], references: [id], onDelete: Cascade)
  approvers TemplateApprover[]

  @@unique([templateId, stageOrder])
}

model TemplateApprover {
  id      String @id @default(uuid())
  stageId String
  userId  String
  isExternalApprover Boolean @default(false)

  stage TemplateStage @relation(fields: [stageId], references: [id], onDelete: Cascade)
  user  User          @relation(fields: [userId], references: [id])

  @@unique([stageId, userId])
}

// ─────────────────────────────────────────────
// RUNTIME WORKFLOW
// ─────────────────────────────────────────────

model WorkflowInstance {
  id              String @id @default(uuid())
  templateId      String
  workspaceId     String
  iteration       Int    @default(1)
  isActive        Boolean      @default(true)
  workflowType    WorkflowType @default(STANDARD)
  status          WorkflowStatus @default(IN_PROGRESS)
  currentStage    Int
  appId       String
  subjectType WorkflowSubjectType
  subjectId   String

  template  WorkflowTemplate @relation(fields: [templateId], references: [id])
  workspace Workspace        @relation(fields: [workspaceId], references: [id])
  stages    StageInstance[]
  comments  Comment[]

  // ✅ Back-relation for ActivityLog.workflow
  activityLogs   ActivityLog[]

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@index([subjectType, subjectId, isActive])
  @@index([appId, isActive])
}

model StageInstance {
  id                 String       @id @default(uuid())
  workflowId         String
  stageOrder         Int
  stageName          String?
  iteration          Int          @default(1)
  isCurrentIteration Boolean      @default(true)
  strategy           StrategyType
  minApprovals       Int?
  startedAt          DateTime?
  dueAt              DateTime?
  escalatedTo        String?
  status             StageStatus  @default(PENDING)

  workflow  WorkflowInstance @relation(fields: [workflowId], references: [id])
  approvals Approval[]

  // ✅ Back-relation for ActivityLog.stage
  // nullable because DEVIATION audit rows have no specific triggering stage
  activityLogs   ActivityLog[]

  @@unique([workflowId, stageOrder, iteration])
  @@index([workflowId, isCurrentIteration])
}

model Approval {
  id         String         @id @default(uuid())
  stageId    String
  approverId String
  status     ApprovalStatus @default(PENDING)
  actedAt    DateTime?
  reason     String?
  isExternalApprover Boolean @default(false)

  stage    StageInstance @relation(fields: [stageId], references: [id], onDelete: Cascade)
  approver User          @relation(fields: [approverId], references: [id])
  comments Comment[]

  @@unique([stageId, approverId])
}

model WorkFlowTemplateUser {
  id         String   @id @default(uuid())
  templateId String
  userId     String
  created_at DateTime @default(now())

  template WorkflowTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  user     User             @relation(fields: [userId], references: [id])

  @@unique([templateId, userId])
  @@index([templateId, userId])
}

// ─────────────────────────────────────────────
// APPROVAL AUDIT
//
// Records every system-level event in the workflow lifecycle.
//
// CHANGES from original:
//   ✅ approverId  → now a proper FK to User   (was plain String)
//   ✅ workflowId  → now a proper FK to WorkflowInstance (was plain String)
//   ✅ stageId     → now nullable String? + optional FK to StageInstance
//
// Why stageId is nullable:
//   DEVIATION audit rows have no single triggering stage — the event applies
//   to the entire old workflow. Storing null here is semantically correct and
//   removes the previous sentinel hack (storing workflowId in the stageId column).
//
// Migration note:
//   Before running `prisma migrate`, update the existing DEVIATION rows in
//   ApprovalAudit to set stageId = NULL where stageId = workflowId.
//   SQL:  UPDATE "ApprovalAudit" a
//         SET    "stageId" = NULL
//         WHERE  a.stageId" = a."workflowId";
// ─────────────────────────────────────────────

model ActivityLog {
  id           String         @id @default(uuid())
  actorId      String?
  actorGuestId String?
  action       String?
  workflowId   String?
  stageId      String?
  metadata     Json?
  createdAt    DateTime       @default(now())
  subjectType  WorkflowSubjectType
  subjectId    String

  actor      User?             @relation(fields: [actorId], references: [id])
  actorGuest Guest?            @relation(fields: [actorGuestId], references: [id])
  workflow   WorkflowInstance? @relation(fields: [workflowId], references: [id])
  stage      StageInstance?    @relation(fields: [stageId], references: [id])

  @@index([subjectId])
  @@index([actorId])
  @@index([actorGuestId])
  @@index([workflowId])
}

// ─────────────────────────────────────────────
// OTHER MODELS
// ─────────────────────────────────────────────

model Department {
  id              String          @id @default(uuid())
  department_code String          @unique
  department_name String
  isActive        Boolean         @default(true)
  event_proposals EventProposal[]
  verticals       Vertical[]
  created_at      DateTime        @default(now())
  updated_at      DateTime        @updatedAt
}

model Vertical {
  id              String          @id @default(uuid())
  name            String
  code            String
  departmentId    String
  department      Department      @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  event_proposals EventProposal[]
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
}

// Zone: unifies what used to be two separate concepts — EventProposal's
// business "Region" (North/South/etc.) and the standalone Zone master
// originally added for User — since they're the same thing. Column names
// (region_code/region_name) are kept as-is rather than renamed to code/name,
// so every existing EventProposal consumer that selects region_name/
// region_code keeps working unchanged; only the Prisma model identifier
// changes here. User.zones (many-to-many — a user can cover more than one
// zone) also points at this same table.
model Zone {
  id              String          @id @default(uuid())
  region_code     String          @unique
  region_name     String
  isActive        Boolean         @default(true)
  event_proposals EventProposal[]
  users           User[]
  created_at      DateTime        @default(now())
  updated_at      DateTime        @updatedAt
}

model Branch {
  id              String          @id @default(uuid())
  branch_code     String          @unique
  branch_name     String
  isActive        Boolean         @default(true)
