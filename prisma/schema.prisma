model Pincode {
  id           String  @id @default(uuid())
  pincode      String
  officeName   String
  officeType   String  // BO | SO | HO
  delivery     String
  district     String
  stateName    String
  circleName   String
  regionName   String
  divisionName String
  latitude     Float
  longitude    Float

  // Full-text search vector — weighted combination of all searchable fields.
  // Populated and kept fresh by trigger: pincode_search_vector_update
  searchVector Unsupported("tsvector")?

  @@index([pincode])           // fast exact pincode lookups
  @@index([stateName])         // reporting: group by state
  @@index([district])          // reporting: group by district
}

// ─────────────────────────────────────────────
// POST-EVENT REPORT
//
// Submitted by the proposer after the event is CONDUCTED.
// Contains 4 event images (stored on S3), structured outcome data,
// and spend information. A validator reviews and either approves
// (VALIDATED) or rejects (REJECTED) with a mandatory reason.
//
// On rejection the proposer can resubmit — individual images can be
// selectively replaced (delete old S3 object, upload new one at same
// position key). Scalar fields can also be updated on resubmit.
// ─────────────────────────────────────────────

model EventReport {
  id                  String       @id @default(uuid())
  epcId               String       @unique
  status              ReportStatus @default(GENERATING)

  eventHighlights     String?

  computedOutcomes    Json?

  rejectionReason     String?
  clarificationReason String?
  generationError     String?

  submittedAt         DateTime  @default(now())
  resubmittedAt       DateTime?
  validatedAt         DateTime?
  validatorId         String
  pdfS3Key            String?

  epc       EventProposal      @relation(fields: [epcId], references: [id], onDelete: Cascade)
  validator User               @relation("ReportValidator", fields: [validatorId], references: [id])
  images    EventReportImage[]

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
}

// ─────────────────────────────────────────────
// EVENT REPORT IMAGE
//
// Exactly 4 images per report (position 1–4).
// Each image is stored independently in S3 so the proposer can
// selectively replace individual positions on resubmit without
// touching the others.
//
// S3 key pattern: report-images/{epcId}/{position}.jpg
// Position-keyed (not uuid) so the key is deterministic — uploading
// to the same position automatically shadows the old object in S3.
// ─────────────────────────────────────────────

model EventReportImage {
  id       String  @id @default(uuid())
  reportId String
  position Int
  caption  String?
  s3Key    String
  fileUrl  String
  mimeType String?

  report EventReport @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@unique([reportId, position])
  @@index([reportId])
}

// ─────────────────────────────────────────────
// IMPORT / EXPORT LOG
//
// Tracks every lead import, lead export, and EPC export job.
// Created on enqueue (PENDING), updated as the worker progresses.
//
// epcId is nullable — populated for LEAD_IMPORT and LEAD_EXPORT
// (which are always scoped to an EPC), null for EPC_EXPORT (workspace-wide).
//
// fileS3Key        — output file (exports) or original input file (import)
// errorFileS3Key   — XLSX of failed rows, only set for LEAD_IMPORT with errors
//
// WHY store only S3 keys and not pre-signed URLs:
//   Pre-signed URLs have a hard AWS cap of 7 days. We generate a fresh
//   URL on every download/error-file GET request instead, so access
//   never expires.
// ─────────────────────────────────────────────

model ImportExportLog {
  id               String             @id @default(uuid())
  type             ImportExportType
  status           ImportExportStatus @default(PENDING)
  triggeredById    String
  workspaceId      String
  epcId            String?            // null for EPC_EXPORT
  jobId            String             // BullMQ job ID
  totalRecords     Int?               // null until job completes
  successRecords   Int?
  failedRecords    Int?
  fileS3Key        String?            // output file key
  errorFileS3Key   String?            // failed-rows XLSX key (LEAD_IMPORT only)
  failureReason    String?            // top-level job failure message
  created_at       DateTime           @default(now())
  updated_at       DateTime           @updatedAt

  triggeredBy User           @relation(fields: [triggeredById], references: [id])
  workspace   Workspace      @relation(fields: [workspaceId], references: [id])
  epc         EventProposal? @relation(fields: [epcId], references: [id])

  @@index([workspaceId, type])
  @@index([triggeredById])
  @@index([epcId])
  @@index([jobId])
}

// ─────────────────────────────────────────────
// NOTIFICATION SYSTEM
//
// Generic, cross-app notification pipeline. Any app (MAP, DIA, Dealer Claims,
// future apps) writes a Notification row via notificationService.notify().
// Delivery (Web Push, SSE) happens asynchronously via a BullMQ worker —
// this table is the source of truth for the in-app notification list,
// independent of whether real-time delivery succeeded.
//
// appKey/entityType/entityId live in `metadata` (Json) rather than as typed
// columns — keeps this model app-agnostic. Apps that need to query/filter
// by their own entity types do so via metadata, not by adding columns here.
// ─────────────────────────────────────────────

model Notification {
  id          String            @id @default(uuid())
  workspaceId String
  recipientId String
  type        String
  title       String
  body        String
  link        String?           // deep link, e.g. /map/epc/:id
  metadata    Json?             // { appKey, epcId, ... } — typed in app layer
  isRead      Boolean           @default(false)
  readAt      DateTime?
  createdAt   DateTime          @default(now())

  recipient User      @relation(fields: [recipientId], references: [id])
  workspace Workspace @relation(fields: [workspaceId], references: [id])

  // Primary query: "give me this user's notifications, newest first"
  @@index([recipientId, createdAt])
  // Unread-count query: "how many unread does this user have"
  @@index([recipientId, isRead])
}

// ─────────────────────────────────────────────
// PUSH SUBSCRIPTION
//
// One row per browser/device subscription (Web Push API, VAPID).
// A user can have multiple active subscriptions (multiple devices/browsers).
// endpoint is unique per the Push API spec — re-subscribing with the same
// endpoint (e.g. browser re-registers service worker) upserts in place.
// ─────────────────────────────────────────────

model PushSubscription {
  id        String   @id @default(uuid())
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  userAgent String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
}

// VENDOR ONBOARDING
//
// Two-phase lifecycle:
//   Phase 1 (no WorkflowInstance yet): AWAITING_VENDOR → VENDOR_SUBMITTED → IN_REVIEW
//   Phase 2 (WorkflowInstance drives it): IN_PROGRESS → APPROVED → CLOSED
//
// Vendor never becomes a User — access is via VendorAccessToken, not JWT.
// Status is a plain string (same convention as EventProposal.status).
// ─────────────────────────────────────────────

model VendorOnboarding {
  id            String   @id @default(uuid())
  referenceNumber String @unique
  workspaceId   String
  initiatedById String
  status        String   @default("AWAITING_VENDOR")

  // ── Vendor-filled (Phase 1) ──
  vendorReferenceName String?
  vendorName        String?
  state             String?
  city              String?
  pinCode           String?
  address           String?
  mobile            String?
  email             String?
  msmeVendor        Boolean?
  bankName          String?
  bankBranch        String?
  ifscCode          String?
  bankAddress       String?
  accountNumber     String?
  gstin             String?
  pan               String?
  entityRegNo       String?
  dpdpConsentedAt   DateTime?
  dpdpConsentIp     String?
  vendorSubmittedAt DateTime?

  // ── Employee-filled (after vendor submission, before approval) ──
  vendorCode                String?
  vendorType                String?
  companyCode               String?
  purchaseOrg               String?
  paymentTerm               String?
  tds                       String?
  vendorCategory            String?
  materialType              String?
  materialSubType           String?
  selfAssessmentObtained    Boolean?
  ndaObtained               Boolean?
  gpaObtained               Boolean?
  isRelatedParty            Boolean?
  vendorAuditReportPrepared Boolean?
  natureOfService           String?
  onboardingReason          String?
  guestId                   String?

   gstApplicability           Boolean? // true = applicable, false = N/A, null = not chosen (treated as applicable)
   incorporationApplicability Boolean? // same meaning as above

  workspace   Workspace                  @relation(fields: [workspaceId], references: [id])
  initiatedBy User                       @relation("VendorOnboardingInitiatedBy", fields: [initiatedById], references: [id])
  guest   Guest? @relation(fields: [guestId], references: [id])
  documents   VendorOnboardingDocument[]

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@index([workspaceId, status])
}

model VendorOnboardingDocument {
  id           String   @id @default(uuid())
  onboardingId String
  documentType String   // GST_CERTIFICATE | PAN_DOCUMENT | CANCELLED_CHEQUE
                         // | INCORPORATION_CERTIFICATE | MSME_CERTIFICATE | NDA_CERTIFICATE
  s3Key        String
  uploadedAt   DateTime @default(now())

  onboarding VendorOnboarding @relation(fields: [onboardingId], references: [id], onDelete: Cascade)

  @@unique([onboardingId, documentType])
  @@index([onboardingId])
}

model AccessToken  {
  id           String    @id @default(uuid())
  subjectType  AccessTokenSubjectType
  subjectId    String
  token        String    @unique
  used         Boolean   @default(false)
  purpose      String
  usedAt       DateTime?
  created_at   DateTime  @default(now())


 @@index([subjectType, subjectId])
}



// MEDICAL CLAIM
//
// Same two-phase lifecycle shape as VendorOnboarding, with one addition:
// after a CLARIFY, the ex-employee (not the initiator) makes the edit —
// see CLARIFICATION_REQUESTED in the status machine comment above.
//
// Ex-employee never becomes a User — access is via AccessToken + Guest,
// same pattern as vendor onboarding. Status is a plain string (same
// convention as VendorOnboarding.status / EventProposal.status).
// ─────────────────────────────────────────────

model MedicalClaim {
  id              String   @id @default(uuid())
  referenceNumber String   @unique
  workspaceId     String
  initiatedById   String
  guestId         String?
  status          String   @default("AWAITING_EX_EMPLOYEE")
  mobile       String?
  email        String?

  // ── Ex-employee-filled ──
  ticketNumber      String?
  grade             String?
  location          String?
  employeeName      String?
  patientName       String?
  claimCover        ClaimCover?
  spouseName        String?
  medicalAdvanceTaken Decimal? @db.Decimal(12, 2)

  // ── Computed server-side at submission — never trust client input ──
  eligibleAmount    Decimal? @db.Decimal(12, 2) // grade cap, looked up at submit time
  alreadySettled    Decimal? @db.Decimal(12, 2) // sum of this guest's approved claims this calendar year
  totalClaimed      Decimal? @db.Decimal(12, 2) // sum of MedicalClaimBill.amount, stored for audit

  declarationAcceptedAt DateTime?
  signatureName          String?
  signatureDate           DateTime?
  submittedAt             DateTime?

  workspace   Workspace          @relation(fields: [workspaceId], references: [id])
  initiatedBy User               @relation("MedicalClaimInitiatedBy", fields: [initiatedById], references: [id])
  guest       Guest?             @relation(fields: [guestId], references: [id])
  bills       MedicalClaimBill[]

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@index([workspaceId, status])
  @@index([guestId])
}

model MedicalClaimBill {
  id        String    @id @default(uuid())
  claimId   String
  claimHead ClaimHead
  billNo    String?
  billName  String?
  billDate  DateTime?
  amount    Decimal   @db.Decimal(12, 2)
  approvedClaimAmount    Decimal?   @db.Decimal(12, 2)
  remarks   String?
  approved  Boolean   @default(false)
  s3Key     String?   // presigned at read time, same convention as every other attachment

  claim MedicalClaim @relation(fields: [claimId], references: [id], onDelete: Cascade)

  @@index([claimId])
}

// Newly created for this app — no existing grade→amount lookup exists yet.
//
// annualCap is nullable: updateUserHrData.ts (HR master sync from EOR) inserts
// a row here for any grade it discovers that isn't already present, but the
// EOR export carries no cap amount — null means "grade known, cap not yet
// set", to be filled in manually. A claim submission against a grade with
// annualCap = null should be treated as "not eligible yet", not as 0.
model GradeEligibility {
  id         String   @id @default(uuid())
  grade      String   @unique
  annualCap  Decimal? @db.Decimal(12, 2)
}

model Guest {
  id        String   @id @default(uuid())
  mobile    String?  @unique
  email     String?  @unique
  password  String?
  name String?
  createdAt DateTime @default(now())

  vendorOnboardings VendorOnboarding[]
  medicalClaims MedicalClaim[]
  activityLogs ActivityLog[]

  @@index([mobile])
  @@index([email])
}

// ─────────────────────────────────────────────
// BUSINESS PARTNER
// ─────────────────────────────────────────────

enum BusinessPartnerOfficeType {
  HEAD_OFFICE
  BRANCH_OFFICE
}
model BusinessPartner {
  id             String @id @default(uuid())

  // External system references (source-of-truth IDs from S4/BYD/C4C/etc.)
  internalId     String? @unique
  vendorId       String?
  bpId           String?
  s4Id           String?
  bydId          String?
  c4cId          String?

  bpName         String
  bpShortName    String?
  isKeyAccount   Boolean @default(false)

  gst            String?
  panNumber      String?
  legalTradeName String?

  officeType     BusinessPartnerOfficeType
  bpType         String?
  entityType     String? // e.g. Proprietary, Pvt Ltd — free text until the value set is confirmed

  vendorCode     String?
  isActive       Boolean   @default(true)
  joinedOn       DateTime?

  // Self-referencing HO → Branch hierarchy
  parentId       String?
  parent         BusinessPartner?  @relation("BusinessPartnerHierarchy", fields: [parentId], references: [id])
  branches       BusinessPartner[] @relation("BusinessPartnerHierarchy")

  addresses      BusinessPartnerAddress[]
  contacts       BusinessPartnerContact[]
  users          User[]

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([parentId])
  @@index([bpType])
  @@index([gst])
  // GST is intentionally denormalized: a BRANCH_OFFICE row stores a copy of its HO's GST
  // rather than a unique constraint. Populated by the service layer at branch-creation time
  // (copy parent.gst → child.gst), not enforced by the DB. No uniqueness constraint on gst.
}

model BusinessPartnerAddress {
  id                String          @id @default(uuid())
  businessPartnerId String
  businessPartner   BusinessPartner @relation(fields: [businessPartnerId], references: [id], onDelete: Cascade)

  address           String?
  city              String?
  state             String?
  country           String?
  pincode           String?
  region            String?
  zone              String?
  branch            String?
  latitude          Float?
  longitude          Float?
  email             String?
  phoneNo           String?
  website           String?
  isDefault         Boolean @default(false)
  isBillingAddress  Boolean @default(false)
  isShippingAddress Boolean @default(false)

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([businessPartnerId])
}

model BusinessPartnerContact {
  id                String          @id @default(uuid())
  businessPartnerId String
  businessPartner   BusinessPartner @relation(fields: [businessPartnerId], references: [id], onDelete: Cascade)

  userId            String?
  user              User?   @relation(fields: [userId], references: [id])

  name              String
  phoneNumber       String?
  email             String?
  panNumber         String?
  isOwner           Boolean @default(false)
  isMainContact     Boolean @default(false)

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  crfsAsRecipient CRF[]

  @@index([businessPartnerId])
  @@index([userId])
}


model MachineStudy {
  id                  String    @id @default(uuid())
  epcId               String
  isCompetitorMachine Boolean   @default(false)

  machineModel        String
  customerName        String
  startDate           DateTime
  endDate             DateTime
  application         String
  fuelType             FuelType
  startHmr             Decimal   @db.Decimal(10, 2)
  endHmr               Decimal   @db.Decimal(10, 2)
  bucketVolumeCuM      Decimal   @db.Decimal(6, 2)
  acStatus             String
  operationMode        String

  // Fuel-efficiency inputs — exactly one side populated, based on fuelType.
  dieselTopUpLtr      Decimal?  @db.Decimal(8, 2)   // required when fuelType = DIESEL
  startKwhReading     Decimal?  @db.Decimal(10, 2)  // required when fuelType = ELECTRIC
  endKwhReading       Decimal?  @db.Decimal(10, 2)  // required when fuelType = ELECTRIC

  operatorName          String?
  operatorExperience    String?
  priorMachinesOperated String?

  epc    EventProposal        @relation(fields: [epcId], references: [id])
  cycles MachineStudyCycle[]

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  // Enforces cardinality: at most one row per (EPC, variant) — one study for
  // single-machine templates, exactly two (false + true) for benchmarking.
  @@unique([epcId, isCompetitorMachine])
  @@index([epcId])
}

model MachineStudyCycle {
  id                String   @id @default(uuid())
  studyId           String
  sequenceNo        Int
  truckNumber       String?           // null for "Material Preparation" rows
  startSeconds      Int               // elapsed seconds from study start
  finishSeconds     Int
  timeTakenSeconds  Int               // provided directly in the source sheet, not derived
  bucketPasses      Int?
  swingAngleDegrees String?
  unladenWeightKg   Decimal? @db.Decimal(8, 2)
  ladenWeightKg     Decimal? @db.Decimal(8, 2)
  payloadKg         Decimal? @db.Decimal(8, 2)     // provided directly, not derived
  remarks           String?

  study MachineStudy @relation(fields: [studyId], references: [id], onDelete: Cascade)

  @@index([studyId])
}
// ─────────────────────────────────────────────────────────────────────────────
// Machine — master record for one physical machine. serialNumber is both
// the business key and the primary key — no separate surrogate id.
// ─────────────────────────────────────────────────────────────────────────────
model Machine {
  id           String       @default(uuid())
  machineSerialNumber String   @id
  // customerId is intentionally left unset here. It's out of scope for
  // both the import and the daily C4C sync — filled by a separate process
  // later. Do not populate this from C4C (CACCOUNT_UUID), even though C4C
  // returns it on every call — confirmed out of scope for now.
  customerId   String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  telemetry MachineTelemetry[]
}

// ─────────────────────────────────────────────────────────────────────────────
// MachineTelemetry — append-only history, one row per machine per daily
// sync run. Never updated in place; each 1am job run adds ~11,100 rows.
//
// syncedAt is set ONCE per job run (not DateTime @default(now()) per row),
// so every machine's row from a given day's sync shares an identical
// timestamp — C4C gives us no per-reading timestamp.
//
// hmr defaults to 0: C4C's current $select list for this entity doesn't
// return an HMR field yet. This column stays real so nothing downstream
// breaks once the real field is wired in — see
// machineTelemetryC4CSync.service.ts for the exact TODO line.
// ─────────────────────────────────────────────────────────────────────────────
model MachineTelemetry {
  id           String      @id @default(uuid())
  machineSerialNumber String
  machine      Machine  @relation(fields: [machineSerialNumber], references: [machineSerialNumber])
  latitude     Decimal
  longitude    Decimal
  hmr          Decimal  @default(0)
  syncedAt     DateTime

  @@index([machineSerialNumber, syncedAt])
}
