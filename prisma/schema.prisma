generator client {
  provider = "prisma-client"
  output   = "../src/prisma/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────────
// ENUMS
// ─────────────────────────────────────────────

enum PermissionAction {
  read
  write
}

enum ScopeType {
  MODULE
}

enum StrategyType {
  ALL
  ANY
  SOME
}

enum WorkflowStatus {
  IN_PROGRESS
  APPROVED
  REJECTED
  // ✅ CHANGE 1: Added SUPERSEDED
  // Marks a workflow that was replaced by a Deviation.
  // Distinguishes "approvers rejected it" (REJECTED) from
  // "a budget change made this workflow obsolete" (SUPERSEDED).
  SUPERSEDED
}

enum StageStatus {
  PENDING
  IN_PROGRESS
  APPROVED
  REJECTED
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  // ✅ CHANGE 2: Added CLARIFY
  // An approver sets this to signal the submitter must provide
  // more information before re-approval. Triggers a full workflow restart.
  CLARIFY
}

// ✅ CHANGE 3: New enum WorkflowType
// Recorded on every WorkflowInstance so the audit trail can distinguish
// a normal first-run from a budget-deviation re-run.
enum WorkflowType {
  STANDARD
  DEVIATION
}

// ✅ CHANGE 4: New enum AuditAction
// Used by ApprovalAudit. Kept separate from ApprovalStatus so the audit
// log can record system-level events (DEVIATION, SUPERSEDED) without
// polluting the per-approval status enum.
enum AuditAction {
  APPROVED
  REJECTED
  CLARIFY
  DEVIATION
}

enum ProductType {
  EPF
  CRF
}

enum ProductCategory {
  EVENT_OVERHEAD
  PRINTED_MATERIAL
  SOUVENIR
  ARTWORK
}

// ─────────────────────────────────────────────
// AUTH MODELS (unchanged)
// ─────────────────────────────────────────────

model User {
  id                    String               @id @default(uuid())
  first_name            String               @db.VarChar(50)
  last_name             String               @db.VarChar(50)
  email                 String               @unique @db.VarChar(100)
  phone_number          String               @unique @db.VarChar(15)
  password              String               @db.VarChar(255)
  is_active             Boolean              @default(true)
  is_default_login      Boolean              @default(true)
  refresh_tokens        RefreshToken[]
  password_reset_tokens PasswordResetToken[]

  workspaceUsers WorkspaceUser[]
  userProfiles   UserProfile[]

  created_event_proposals EventProposal[] @relation("EventCreatedBy")
  updated_event_proposals EventProposal[] @relation("EventUpdatedBy")

  created_workflow WorkflowTemplate[] @relation("WorkFlowCreatedBy")
  updated_workflow WorkflowTemplate[] @relation("WorkFlowUpdatedBy")

  approvals         Approval[]
  templateApprovals TemplateApprover[]
  workFlowUsers     WorkFlowTemplateUser[]
  comments          Comment[]

  created_at DateTime @default(now()) @db.Timestamp(6)
  updated_at DateTime @default(now()) @db.Timestamp(6)
}

model PasswordResetToken {
  id         String   @id @default(uuid())
  user_id    String
  user       User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  token      String   @unique @db.VarChar(255)
  expires_at DateTime
  used       Boolean  @default(false)
  created_at DateTime @default(now())
}

model RefreshToken {
  id         String   @id @default(uuid())
  token_id   String   @unique @db.VarChar(36)
  token_hash String   @db.VarChar(255)
  token      String   @unique
  user_id    String
  user       User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  user_agent String?
  ip_address String?
  revoked    Boolean  @default(false)
  expires_at DateTime
  created_at DateTime @default(now())
}

model DailyVisitors {
  id           String   @id @default(uuid())
  date         DateTime @unique @db.Date
  total_visits Int      @default(0)
  created_at   DateTime @default(now())

  @@index([date])
}

// ─────────────────────────────────────────────
// WORKSPACE
// ─────────────────────────────────────────────

model Workspace {
  id   String @id @default(uuid())
  name String

  users        WorkspaceUser[]
  apps         WorkspaceApp[]
  profiles     Profile[]
  userProfiles UserProfile[]

  workflowTemplates WorkflowTemplate[]
  workflows         WorkflowInstance[]

  created_at DateTime @default(now()) @db.Timestamp(6)
  updated_at DateTime @default(now()) @db.Timestamp(6)
}

model WorkspaceUser {
  userId       String
  workspaceId  String
  isSuperAdmin Boolean  @default(false)
  joinedAt     DateTime @default(now())

  user      User      @relation(fields: [userId], references: [id])
  workspace Workspace @relation(fields: [workspaceId], references: [id])

  @@id([userId, workspaceId])
  @@index([workspaceId])
}

// ─────────────────────────────────────────────
// APP + MODULE (unchanged)
// ─────────────────────────────────────────────

model App {
  id   String @id @default(uuid())
  key  String @unique
  name String

  workspaceApps    WorkspaceApp[]
  modules          Module[]
  workFlowTemplate WorkflowTemplate[]

  created_at DateTime @default(now())
  updated_at DateTime @default(now())
}

model WorkspaceApp {
  workspaceId String
  appId       String
  enabled     Boolean  @default(true)
  enabledAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id])
  app       App       @relation(fields: [appId], references: [id])

  @@id([workspaceId, appId])
  @@index([workspaceId])
}

model Module {
  id         String   @id @default(uuid())
  key        String
  name       String
  appId      String
  created_at DateTime @default(now()) @db.Timestamp(6)
  updated_at DateTime @default(now()) @db.Timestamp(6)

  app                App                 @relation(fields: [appId], references: [id])
  profilePermissions ProfilePermission[]

  @@unique([appId, key])
}

// ─────────────────────────────────────────────
// PROFILE (unchanged)
// ─────────────────────────────────────────────

model Profile {
  id              String  @id @default(uuid())
  name            String
  description     String?
  workspaceId     String
  isSystemProfile Boolean @default(false)
  created_at      DateTime @default(now()) @db.Timestamp(6)
  updated_at      DateTime @default(now()) @db.Timestamp(6)

  workspace    Workspace           @relation(fields: [workspaceId], references: [id])
  permissions  ProfilePermission[]
  userProfiles UserProfile[]

  @@unique([workspaceId, name])
  @@index([workspaceId])
}

model ProfilePermission {
  id        String           @id @default(uuid())
  profileId String
  action    PermissionAction
  moduleId  String

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  module  Module  @relation(fields: [moduleId], references: [id])

  @@unique([profileId, action, moduleId])
  @@index([profileId, moduleId])
}

model UserProfile {
  id          String   @id @default(uuid())
  userId      String
  workspaceId String
  profileId   String
  assignedAt  DateTime @default(now())
  assignedBy  String?

  user      User      @relation(fields: [userId], references: [id])
  workspace Workspace @relation(fields: [workspaceId], references: [id])
  profile   Profile   @relation(fields: [profileId], references: [id])

  @@unique([userId, workspaceId, profileId])
  @@index([userId, workspaceId, profileId])
}

// ─────────────────────────────────────────────
// BUSINESS DATA
// ─────────────────────────────────────────────

model EventProposal {
  id                String   @id @default(uuid())
  proposal_number   String   @unique
  event_from_date   DateTime
  event_to_date     DateTime
  event_description String
  location          String
  event_objective   String
  status            String   @default("PENDING")

  created_by_id    String
  updated_by_id    String
  department_id    String
  region_id        String
  branch_id        String
  event_scale      Int
  budget_master_id String
  event_name_id    String
  vertical_id      String

  department    Department   @relation(fields: [department_id], references: [id])
  vertical      Vertical     @relation(fields: [vertical_id], references: [id])
  region        Region       @relation(fields: [region_id], references: [id])
  branch        Branch       @relation(fields: [branch_id], references: [id])
  budget_master BudgetMaster @relation(fields: [budget_master_id], references: [id])
  event_name    EventName    @relation(fields: [event_name_id], references: [id])
  created_by    User         @relation("EventCreatedBy", fields: [created_by_id], references: [id])
  updated_by    User         @relation("EventUpdatedBy", fields: [updated_by_id], references: [id])

  epf EPF?
  crf CRF?

  // ✅ CHANGE 5: workflows (plural) — was `workflow WorkflowInstance?`
  // One EPC can now have many workflows over time (Deviation creates a new one).
  // Only one will have isActive = true at any moment.
  // Prisma relation is now a list; filter by isActive:true for current state.
  workflows WorkflowInstance[]

  search_vector Unsupported("tsvector")?
  created_at    DateTime                 @default(now())
  updated_at    DateTime                 @updatedAt
}

// ─────────────────────────────────────────────
// WORKFLOW TEMPLATE SYSTEM
// ─────────────────────────────────────────────

model WorkflowTemplate {
  id          String  @id @default(uuid())
  name        String
  description String

  workspaceId String
  isActive    Boolean @default(true)
  appId       String
  metaData_1  String
  metaData_2  String
  metaData_3  String

  created_by_id String
  updated_by_id String
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt

  stages            TemplateStage[]
  workflowInstances WorkflowInstance[]
  workFlowUsers     WorkFlowTemplateUser[]

  app        App              @relation(fields: [appId], references: [id])
  workspace  Workspace        @relation(fields: [workspaceId], references: [id])
  created_by User             @relation("WorkFlowCreatedBy", fields: [created_by_id], references: [id])
  updated_by User             @relation("WorkFlowUpdatedBy", fields: [updated_by_id], references: [id])
}

model TemplateStage {
  id           String       @id @default(uuid())
  name         String
  templateId   String
  stageOrder   Int
  strategy     StrategyType
  minApprovals Int?

  template  WorkflowTemplate  @relation(fields: [templateId], references: [id], onDelete: Cascade)
  approvers TemplateApprover[]

  @@unique([templateId, stageOrder])
}

model TemplateApprover {
  id      String @id @default(uuid())
  stageId String
  userId  String

  stage TemplateStage @relation(fields: [stageId], references: [id], onDelete: Cascade)
  user  User          @relation(fields: [userId], references: [id])

  @@unique([stageId, userId])
}

// ─────────────────────────────────────────────
// RUNTIME WORKFLOW
// ─────────────────────────────────────────────

model WorkflowInstance {
  id              String @id @default(uuid())
  templateId      String
  workspaceId     String
  // ✅ CHANGE 6: Removed @unique from eventProposalId
  // Previously @unique enforced one workflow per EPC forever.
  // Deviation requires creating a second WorkflowInstance for the same EPC,
  // so the uniqueness constraint must be removed.
  eventProposalId String

  // ✅ CHANGE 7: Added iteration
  // Tracks how many Clarify re-runs have happened within this workflow.
  // Starts at 1. Each CLARIFY increments this by 1.
  // New StageInstances are created for each iteration; old ones are kept for history.
  iteration Int @default(1)

  // ✅ CHANGE 8: Added isActive
  // Only one WorkflowInstance per EPC is active at a time.
  // When a Deviation is triggered, the current workflow is set to isActive=false + SUPERSEDED,
  // and a brand-new WorkflowInstance is created with isActive=true.
  isActive Boolean @default(true)

  // ✅ CHANGE 9: Added workflowType
  // Lets you distinguish the original workflow from a budget-deviation workflow
  // in reports, audit logs, and the UI without inspecting child records.
  workflowType WorkflowType @default(STANDARD)

  status       WorkflowStatus @default(IN_PROGRESS)
  currentStage Int

  template  WorkflowTemplate @relation(fields: [templateId], references: [id])
  workspace Workspace        @relation(fields: [workspaceId], references: [id])
  event     EventProposal    @relation(fields: [eventProposalId], references: [id])
  stages    StageInstance[]

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  // ✅ CHANGE 10: Composite index on (eventProposalId, isActive)
  // The most common query pattern is "give me the active workflow for this EPC".
  // This index makes that O(1) instead of a full table scan.
  @@index([eventProposalId, isActive])
}

model StageInstance {
  id         String @id @default(uuid())
  workflowId String
  stageOrder Int
  stageName String?

  // ✅ CHANGE 11: Added iteration
  // Mirrors WorkflowInstance.iteration. Every stage created for iteration N
  // carries iteration=N. Lets you group all stages of a single clarify-run together
  // and query history by run number.
  iteration Int @default(1)

  // ✅ CHANGE 12: Added isCurrentIteration
  // The boolean flag that makes Prisma queries practical.
  // Problem: Prisma WHERE clauses cannot compare two columns from the same row
  // (e.g. stage.iteration === stage.workflow.iteration).
  // Solution: flip this flag. When CLARIFY fires, all existing stages get
  // isCurrentIteration=false and the new iteration's stages are created with
  // isCurrentIteration=true. Every "current state" query just adds
  // `isCurrentIteration: true` — no raw SQL needed.
  isCurrentIteration Boolean @default(true)

  strategy     StrategyType
  minApprovals Int?
  startedAt    DateTime?
  dueAt        DateTime?
  escalatedTo  String?

  status StageStatus @default(PENDING)

  workflow  WorkflowInstance @relation(fields: [workflowId], references: [id])
  approvals Approval[]

  // ✅ CHANGE 13: Updated unique constraint
  // Was @@unique([workflowId, stageOrder]) — this would reject inserting
  // stage 1 a second time (for iteration 2). Now iteration is part of the key
  // so the same stageOrder can exist multiple times across iterations.
  @@unique([workflowId, stageOrder, iteration])

  // ✅ CHANGE 14: Index on (workflowId, isCurrentIteration)
  // Supports the extremely common query: "give me current stages for workflow X".
  @@index([workflowId, isCurrentIteration])
}

model Approval {
  id         String @id @default(uuid())
  stageId    String
  approverId String

  // ✅ ApprovalStatus now includes CLARIFY (see enum above)
  status  ApprovalStatus @default(PENDING)
  actedAt DateTime?
  reason  String?

  stage    StageInstance @relation(fields: [stageId], references: [id])
  approver User          @relation(fields: [approverId], references: [id])
  comments Comment[]

  @@unique([stageId, approverId])
}

model WorkFlowTemplateUser {
  id         String   @id @default(uuid())
  templateId String
  userId     String
  created_at DateTime @default(now())

  template WorkflowTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  user     User             @relation(fields: [userId], references: [id])

  @@unique([templateId, userId])
  @@index([templateId, userId])
}

// ─────────────────────────────────────────────
// OTHER MODELS (unchanged)
// ─────────────────────────────────────────────

model Department {
  id              String          @id @default(uuid())
  department_code String          @unique
  department_name String
  isActive        Boolean         @default(true)
  event_proposals EventProposal[]
  verticals       Vertical[]
  created_at      DateTime        @default(now())
  updated_at      DateTime        @updatedAt
}

model Vertical {
  id              String          @id @default(uuid())
  name            String
  code            String
  departmentId    String
  department      Department      @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  event_proposals EventProposal[]
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
}

model Region {
  id              String          @id @default(uuid())
  region_code     String          @unique
  region_name     String
  isActive        Boolean         @default(true)
  event_proposals EventProposal[]
  created_at      DateTime        @default(now())
  updated_at      DateTime        @updatedAt
}

model Branch {
  id              String          @id @default(uuid())
  branch_code     String          @unique
  branch_name     String
  isActive        Boolean         @default(true)
  event_proposals EventProposal[]
  created_at      DateTime        @default(now())
  updated_at      DateTime        @updatedAt
}

model BudgetMaster {
  id              String          @id @default(uuid())
  fiscal_year     String
  code            String
  id_desc         String
  value           Decimal
  event_proposals EventProposal[]
  created_at      DateTime        @default(now())
  updated_at      DateTime        @updatedAt
}

model EventName {
  id     String          @id @default(uuid())
  title  String
  events EventProposal[]
}

// ✅ CHANGE 15: action field changed from ApprovalStatus → AuditAction
// ApprovalStatus covers per-approver decisions (PENDING/APPROVED/REJECTED/CLARIFY).
// AuditAction covers system-level events that don't map to an approver decision,
// like DEVIATION (a whole new workflow was created due to budget change).
// Keeping them separate makes both enums clean and independently extensible.
model ApprovalAudit {
  id         String      @id @default(uuid())
  workflowId String
  stageId    String
  approverId String
  action     AuditAction
  reason     String?
  createdAt  DateTime    @default(now())
}

model ProductMaster {
  id          String @id @default(uuid())

  productType ProductType
  category    ProductCategory

  partNumber  String   @unique
  name        String
  description String?

  unitRate Decimal @db.Decimal(10, 2)

  isActive Boolean @default(true)

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  lineItems LineItem[]
}

model EPF {
  id    String @id @default(uuid())
  epcId String @unique
  status String?
  epc EventProposal @relation(fields: [epcId], references: [id])
  // 👥 Participants
  externalParticipants Int?
  internalParticipants Int?
  // 💰 Budget
  eventBudget     Decimal? @db.Decimal(12, 2)
  annualBudget    Decimal? @db.Decimal(12, 2)
  availableBudget Decimal? @db.Decimal(12, 2)
  // 🤝 Dealer Contribution
  dealerName          String?
  dealerPercent       Int? 
  dealerShare         Int? 
  tataHitachiPoAmount Int? 
  lineItems LineItem[]
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
}

model CRF {
  id    String @id @default(uuid())
  epcId String @unique

  epc EventProposal @relation(fields: [epcId], references: [id])

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  lineItems LineItem[]
}

model LineItem {
  id String @id @default(uuid())

  epfId     String?
  crfId     String?
  productId String

  quantity Decimal @db.Decimal(10, 2)
  rate     Decimal @db.Decimal(10, 2)
  amount   Decimal @db.Decimal(12, 2)

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  epf     EPF?          @relation(fields: [epfId], references: [id])
  crf     CRF?          @relation(fields: [crfId], references: [id])
  product ProductMaster @relation(fields: [productId], references: [id])

  @@index([epfId])
  @@index([crfId])
}

model Comment {
  id         String   @id @default(uuid())
  message    String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  userId     String
  approvalId String
  type       String   @default("COMMENT")

  user     User     @relation(fields: [userId], references: [id])
  approval Approval @relation(fields: [approvalId], references: [id], onDelete: Cascade)

  @@index([approvalId])
  @@index([userId])
}
