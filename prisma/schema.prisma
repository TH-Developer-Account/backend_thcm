generator client {
  provider = "prisma-client"
  output   = "../src/prisma/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────────
// ENUMS
// ─────────────────────────────────────────────

enum PermissionAction {
  read
  write
}

enum ScopeType {
  MODULE
}

// ✅ NEW ENUMS (WORKFLOW)

enum StrategyType {
  ALL
  ANY
  QUORUM
}

enum WorkflowStatus {
  IN_PROGRESS
  APPROVED
  REJECTED
}

enum StageStatus {
  PENDING
  IN_PROGRESS
  APPROVED
  REJECTED
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

// ─────────────────────────────────────────────
// AUTH MODELS (unchanged)
// ─────────────────────────────────────────────

model User {
  id                   String               @id @default(uuid())
  first_name           String               @db.VarChar(50)
  last_name            String               @db.VarChar(50)
  email                String               @unique @db.VarChar(100)
  phone_number         String               @unique @db.VarChar(15)
  password             String               @db.VarChar(255)
  is_active            Boolean              @default(true)
  is_default_login     Boolean              @default(true)
  refresh_tokens       RefreshToken[]
  password_reset_tokens PasswordResetToken[]

  workspaceUsers       WorkspaceUser[]
  userProfiles         UserProfile[]

  created_event_proposals EventProposal[] @relation("EventCreatedBy")
  updated_event_proposals EventProposal[] @relation("EventUpdatedBy")

  // ✅ NEW
  approvals Approval[]
  templateApprovals TemplateApprover[]

  created_at DateTime @default(now()) @db.Timestamp(6)
  updated_at DateTime @default(now()) @db.Timestamp(6)
}

model PasswordResetToken {
  id         String   @id @default(uuid())
  user_id    String
  user       User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  token      String   @unique @db.VarChar(255)
  expires_at DateTime
  used       Boolean  @default(false)
  created_at DateTime @default(now())
}

model RefreshToken {
  id         String   @id @default(uuid())
  token_id   String   @unique @db.VarChar(36)
  token_hash String   @db.VarChar(255)
  token      String   @unique
  user_id    String
  user       User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  user_agent String?
  ip_address String?
  revoked    Boolean  @default(false)
  expires_at DateTime
  created_at DateTime @default(now())
}

model DailyVisitors {
  id           String   @id @default(uuid())
  date         DateTime @unique @db.Date
  total_visits Int      @default(0)
  created_at   DateTime @default(now())

  @@index([date])
}

// ─────────────────────────────────────────────
// WORKSPACE
// ─────────────────────────────────────────────

model Workspace {
  id   String @id @default(uuid())
  name String

  users        WorkspaceUser[]
  apps         WorkspaceApp[]
  profiles     Profile[]
  userProfiles UserProfile[]

  // ✅ NEW
  workflowTemplates WorkflowTemplate[]
  workflows         WorkflowInstance[]

  created_at DateTime @default(now()) @db.Timestamp(6)
  updated_at DateTime @default(now()) @db.Timestamp(6)
}

// Tracks which users belong to a workspace.
// isSuperAdmin = true bypasses all permission checks for that user.
model WorkspaceUser {
  userId       String
  workspaceId  String
  isSuperAdmin Boolean  @default(false)
  joinedAt     DateTime @default(now())

  user      User      @relation(fields: [userId], references: [id])
  workspace Workspace @relation(fields: [workspaceId], references: [id])

  @@id([userId, workspaceId])
  @@index([workspaceId])
}

// ─────────────────────────────────────────────
// APP + MODULE (unchanged)
// ─────────────────────────────────────────────

// An App is a global entity (e.g. MAP, HR, CRM).
// It exists once and can be enabled in many workspaces.
model App {
  id   String @id @default(uuid())
  key  String @unique
  name String

  workspaceApps WorkspaceApp[]
  modules       Module[]

  created_at DateTime @default(now())
  updated_at DateTime @default(now())
}

// Tracks which apps are enabled in a workspace.
// enabled = false means the app is soft-disabled for that workspace.
model WorkspaceApp {
  workspaceId String
  appId       String
  enabled     Boolean  @default(true)
  enabledAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id])
  app       App       @relation(fields: [appId], references: [id])

  @@id([workspaceId, appId])
  @@index([workspaceId])
}

// A Module belongs to an App (e.g. EPC, EPF, CRF belong to MAP).
model Module {
  id    String @id @default(uuid())
  key   String
  name  String
  appId String
  created_at DateTime @default(now()) @db.Timestamp(6)
  updated_at DateTime @default(now()) @db.Timestamp(6)

  app                App                 @relation(fields: [appId], references: [id])
  profilePermissions ProfilePermission[]

  @@unique([appId, key])
}

// ─────────────────────────────────────────────
// PROFILE (unchanged)
// ─────────────────────────────────────────────

// A Profile is just a NAMED CONTAINER for a set of permissions.
// It has NO scope of its own — scope lives on each ProfilePermission row.
//
// Example profiles:
//   "Field Engineer"   → WRITE on MAP app + READ everywhere
//   "HR Admin"         → WRITE on HR app
//   "Read-Only User"   → READ across workspace
//   "EPC Specialist"   → WRITE on MAP→EPC module only

model Profile {
  id              String  @id @default(uuid())
  name            String
  description     String?
  workspaceId     String
  isSystemProfile Boolean @default(false)
   created_at DateTime @default(now()) @db.Timestamp(6)
  updated_at DateTime @default(now()) @db.Timestamp(6)

  workspace    Workspace           @relation(fields: [workspaceId], references: [id])
  permissions  ProfilePermission[]
  userProfiles UserProfile[]

  @@unique([workspaceId, name])
   @@index([workspaceId])
}

// ─────────────────────────────────────────────
// PROFILE PERMISSION
// ─────────────────────────────────────────────

// One row = "this profile grants action X on module Y"
// Every permission is explicit — there is no wildcard or blanket scope.
//
// Example for "Field Engineer" (read+write on MAP modules, read on HR):
//   read  | MODULE | epc-id
//   write | MODULE | epc-id
//   read  | MODULE | epf-id
//   write | MODULE | epf-id
//   read  | MODULE | payroll-id
//
// This table is the full, auditable list of what each profile can do.
model ProfilePermission {
  id        String           @id @default(uuid())
  profileId String
  action    PermissionAction
  moduleId  String

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  module  Module  @relation(fields: [moduleId], references: [id])

  @@unique([profileId, action, moduleId])
   @@index([profileId, moduleId])
}

model UserProfile {
  id          String   @id @default(uuid())
  userId      String
  workspaceId String
  profileId   String
  assignedAt  DateTime @default(now())
  assignedBy  String?  

  user      User      @relation(fields: [userId], references: [id])
  workspace Workspace @relation(fields: [workspaceId], references: [id])
  profile   Profile   @relation(fields: [profileId], references: [id])

  @@unique([userId, workspaceId, profileId])
  @@index([userId, workspaceId,profileId])
}

// ─────────────────────────────────────────────
// BUSINESS DATA
// ─────────────────────────────────────────────

model EventProposal {
  id               String   @id @default(uuid())
  proposal_number  String   @unique
  event_from_date  DateTime
  event_to_date    DateTime
  event_description String
  location         String
  event_objective  String
  status           String   @default("PENDING")

  created_by_id    String
  updated_by_id    String
  department_id    String
  region_id        String
  branch_id        String
  event_scale_id   String
  budget_master_id String
  event_name_id    String

  department    Department   @relation(fields: [department_id], references: [id])
  region        Region       @relation(fields: [region_id], references: [id])
  branch        Branch       @relation(fields: [branch_id], references: [id])
  event_scale   EventScale   @relation(fields: [event_scale_id], references: [id])
  budget_master BudgetMaster @relation(fields: [budget_master_id], references: [id])
  event_name    EventName    @relation(fields: [event_name_id], references: [id])
  created_by    User         @relation("EventCreatedBy", fields: [created_by_id], references: [id])
  updated_by    User         @relation("EventUpdatedBy", fields: [updated_by_id], references: [id])
  
  workflow WorkflowInstance?
  search_vector Unsupported("tsvector")?

  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt
}

// ─────────────────────────────────────────────
// ✅ WORKFLOW SYSTEM
// ─────────────────────────────────────────────

model WorkflowTemplate {
  id          String   @id @default(uuid())
  name        String

  workspaceId String
  regionId    String
  minBudget   Decimal
  maxBudget   Decimal

  priority    Int      @default(0)
  isActive    Boolean  @default(true)

  workspace Workspace @relation(fields: [workspaceId], references: [id])
  region    Region    @relation(fields: [regionId], references: [id])

  stages TemplateStage[]
  workflowInstances WorkflowInstance[]

  created_at DateTime @default(now())
}

model TemplateStage {
  id            String   @id @default(uuid())
  templateId    String
  stageOrder    Int
  strategy      StrategyType
  minApprovals  Int?

  template  WorkflowTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  approvers TemplateApprover[]

  @@unique([templateId, stageOrder])
}

model TemplateApprover {
  id       String @id @default(uuid())
  stageId  String
  userId   String

  stage TemplateStage @relation(fields: [stageId], references: [id], onDelete: Cascade)
  user  User          @relation(fields: [userId], references: [id])

  @@unique([stageId, userId])
}

// ─────────────────────────────────────────────
// RUNTIME
// ─────────────────────────────────────────────

model WorkflowInstance {
  id               String @id @default(uuid())
  templateId       String
  workspaceId      String
  eventProposalId  String @unique

  status           WorkflowStatus @default(IN_PROGRESS)
  currentStage     Int

  template  WorkflowTemplate @relation(fields: [templateId], references: [id])
  workspace Workspace        @relation(fields: [workspaceId], references: [id])
  event     EventProposal    @relation(fields: [eventProposalId], references: [id])

  stages StageInstance[]

  created_at DateTime @default(now())
}

model StageInstance {
  id           String @id @default(uuid())
  workflowId   String
  stageOrder   Int
  strategy     StrategyType
  minApprovals Int?

  status StageStatus @default(PENDING)

  workflow  WorkflowInstance @relation(fields: [workflowId], references: [id])
  approvals Approval[]

  @@unique([workflowId, stageOrder])
}

model Approval {
  id          String @id @default(uuid())
  stageId     String
  approverId  String

  status      ApprovalStatus @default(PENDING)
  actedAt     DateTime?

  stage    StageInstance @relation(fields: [stageId], references: [id])
  approver User          @relation(fields: [approverId], references: [id])

  @@unique([stageId, approverId])
}

// ─────────────────────────────────────────────
// OTHER MODELS (unchanged)
// ─────────────────────────────────────────────

model Department {
  id              String          @id @default(uuid())
  department_code String          @unique
  department_name String
  event_proposals EventProposal[]
  created_at      DateTime        @default(now())
  updated_at      DateTime        @updatedAt
}

model Region {
  id              String          @id @default(uuid())
  region_code     String          @unique
  region_name     String
  event_proposals EventProposal[]
  created_at      DateTime        @default(now())
  updated_at      DateTime        @updatedAt

  // ✅ NEW
  workflowTemplates WorkflowTemplate[]
}

model Branch {
  id              String          @id @default(uuid())
  branch_code     String          @unique
  branch_name     String
  event_proposals EventProposal[]
  created_at      DateTime        @default(now())
  updated_at      DateTime        @updatedAt
}

model EventScale {
  id              String          @id @default(uuid())
  code            String          @unique
  title           String
  event_proposals EventProposal[]
  created_at      DateTime        @default(now())
  updated_at      DateTime        @updatedAt
}

model BudgetMaster {
  id              String          @id @default(uuid())
  fiscal_year     String
  code            String
  id_desc         String
  value           Decimal
  event_proposals EventProposal[]
  created_at      DateTime        @default(now())
  updated_at      DateTime        @updatedAt
}

model EventName {
  id     String          @id @default(uuid())
  title  String
  events EventProposal[]
}