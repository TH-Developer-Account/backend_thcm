// ─────────────────────────────────────────────
// CRF × SHOPIFY (SOUVENIRS)
//
// Souvenir lines on a CRF come from a live Shopify catalog instead of the
// seeded CRF-SV-* ProductMaster rows. Printed Materials and Artworks are
// unaffected — they stay on ProductMaster/CrfItem(source=CATALOG) exactly
// as LineItem worked before.
//
// Key decisions (see claude/decisions-and-learnings.md for the discussion):
//  - CRF rides the EPC's own workflow; it has no approval flow of its own.
//  - CrfItem(source=SHOPIFY) stores sku + requestedQty, plus a client-
//    supplied `amount` kept as an audit/historical snapshot of what the
//    line was worth at request time. `amount` is never re-derived from a
//    live Shopify price and is never used to decide the stock-shortfall
//    budget cap or the debit note — those keep re-checking Shopify
//    directly. Confirmed order facts (what Shopify actually charged) ARE
//    persisted on CrfOrder, since that's MAP's own transaction record, not
//    live catalog data.
//  - REVISED DECISION: title/variantTitle/imageUrl/rate (unit price) ARE
//    now persisted on CrfItem for SHOPIFY lines too (previously none of a
//    souvenir's display fields were stored — only sku/requestedQty/amount
//    — which meant reopening a saved CRF showed printed-material/artwork
//    lines correctly but souvenir lines with only sku/qty/amount, no name
//    or image). These four fields are the same kind of trusted
//    client-supplied snapshot as `amount` above (validated for sanity,
//    never re-derived from a live Shopify lookup) — see
//    buildShopifyItemRows in crf.service.ts. compareAtPrice and gstRate
//    remain intentionally NOT persisted — still display-only, backfilled
//    live each time (see backfillSouvenirDisplayFields in core/mapper.ts).
//  - Recipient + shipping/billing address are collected AFTER EPC approval,
//    right before the proposer places the order — not during drafting.
//  - Stock check (post-approval) and order placement (on "Place order") are
//    synchronous calls to thcmShop.service.ts — no background worker/queue.
//    A stock check that can't reach THCM Shop (the store is down/
//    unreachable) marks the CRF STOCK_CHECK_FAILED rather than leaving it
//    silently un-advanced — see CrfStatus and crfOrder.service.ts's
//    runPostApprovalStockCheck/retryStockCheck.
//  - On a stock shortfall the proposer either swaps souvenir lines and
//    resubmits, or accepts a partial order with the shortfall recorded as
//    CrfOrder.debitNoteAmount for Tata Hitachi to settle outside THCM.
//  - shortfallAmount / pendingDebitAmount (added for the swap-budget fix):
//    souvenirTotalAtApproval is the frozen total of ALL approved souvenir
//    value (in-stock + short combined) and is kept only as the original
//    approval-time snapshot; it is no longer used as the swap budget cap,
//    because live re-pricing of the KEPT (in-stock) lines let that cap
//    drift away from the true shortfall value. shortfallAmount is instead
//    frozen to just the short lines' value whenever the CRF enters/re-
//    enters STOCK_SHORTFALL (post-approval check or after a swap that's
//    still short), and is the real swap budget. pendingDebitAmount
//    accumulates the unused balance whenever a swap resolves the shortfall
//    for less than that budget — carried forward and folded into
//    CrfOrder.debitNoteAmount at order placement. See swapSouvenirLines /
//    runPostApprovalStockCheck / executeOrderPlacement in crfOrder.service.ts.
// ─────────────────────────────────────────────

model CRF {
  id        String    @id @default(uuid())
  epcId     String    @unique
  crfNumber String?   @unique          // "CRF-2026-0042" — proposal_number with EPC→CRF swap, set at creation
  status    CrfStatus @default(OPEN)

  // Recipient — collected post-approval, alongside addresses (not during drafting)
  recipientType          CrfRecipientType?
  recipientName          String?
  recipientPhone         String?
  recipientEmail         String?
  recipientOrganisation  String?
  recipientUserId        String?
  recipientUser           User?                   @relation("CrfRecipientUser", fields: [recipientUserId], references: [id])
  recipientContactId      String?
  recipientContact        BusinessPartnerContact? @relation(fields: [recipientContactId], references: [id])
  deliveryInstructions    String?
  requiredByDate          DateTime?

  // Shipping address — collected post-approval alongside the recipient
  // fields above, in the same dispatch-details step. Inlined directly onto
  // CRF rather than a separate CrfAddress table: with billing address
  // dropped, a CRF only ever has one address, so a join table with a
  // `type` discriminator would exist to serve a distinction that no
  // longer exists. Only sent to THCM as `shippingAddress` on Create Order
  // — THCM's API has no billing-address concept at all.
  addressSourceType CrfAddressSource @default(MANUAL)
  addressSourceId   String?          // e.g. BusinessPartnerAddress.id it was prefilled from
  addressCompany    String?
  addressLine1      String?
  addressLine2      String?
  addressLandmark   String?
  addressCity       String?
  addressDistrict   String?
  addressState      String?
  addressPincode    String?          @db.VarChar(6)
  addressCountry    String?          @default("India")
  addressGstin      String?          @db.VarChar(15)
  addressValidatedAt DateTime?

  souvenirTotalAtApproval Decimal?  @db.Decimal(12, 2)  // frozen approval-time snapshot of ALL souvenir value (in-stock + short); historical only, no longer used as the swap cap — see shortfallAmount
  shortfallAmount         Decimal?  @db.Decimal(12, 2)  // frozen value of the CURRENT OUT_OF_STOCK lines; the real swap budget; null when not in shortfall
  pendingDebitAmount      Decimal?  @db.Decimal(12, 2)  // leftover from an under-spent swap, carried forward and billed at order placement
  approvedAt              DateTime?
  itemsChangedAt          DateTime?
  closedAt                DateTime?

  created_by_id String
  created_by    User    @relation("CrfCreatedBy", fields: [created_by_id], references: [id])
  updated_by_id String?

  epc EventProposal @relation(fields: [epcId], references: [id], onDelete: Cascade)

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  lineItems LineItem[]    // kept through the migration window — see migration notes, dropped in the contract step
  items     CrfItem[]
  order     CrfOrder?

  @@index([status])
}

model CrfItem {
  id    String @id @default(uuid())
  crfId String
  crf   CRF    @relation(fields: [crfId], references: [id], onDelete: Cascade)

  category  ProductCategory   // PRINTED_MATERIAL | SOUVENIR | ARTWORK
  source    CrfItemSource
  sortOrder Int               @default(0)

  // CATALOG lines (printed material / artwork) — same shape as today's LineItem.
  // `amount`/`rate` are shared with SHOPIFY lines below: CATALOG rows get
  // them computed server-side from ProductMaster.unitRate; SHOPIFY rows get
  // them from the client's trusted request-time snapshot (see
  // buildShopifyItemRows in crf.service.ts) — never a live Shopify price
  // re-check either way.
  productId String?
  product   ProductMaster? @relation(fields: [productId], references: [id])
  quantity  Decimal?       @db.Decimal(10, 2)
  rate      Decimal?       @db.Decimal(10, 2)
  amount    Decimal?       @db.Decimal(12, 2)
  width     String?
  height    String?
  unit      String?

  // SHOPIFY lines (souvenirs) — identity + a trusted display-snapshot taken
  // at request time (title/variantTitle/imageUrl, plus `rate` above as unit
  // price). Deliberately still NOT stored: compareAtPrice, gstRate, live
  // stock — those stay display-only, backfilled from a live catalog lookup
  // each time (see backfillSouvenirDisplayFields, core/mapper.ts).
  sku          String?
  requestedQty Int?
  title        String?  // product title at request time, e.g. "Tata Hitachi Cap"
  variantTitle String?  // e.g. "M / Orange" — null for single-variant products
  imageUrl     String?

  qtyAtApproval Int?   // frozen at EPC final approval

  status        CrfItemStatus @default(REQUESTED)
  removedAt     DateTime?
  removedById   String?
  deliveredAt   DateTime?     // manual mark, PRINTED_MATERIAL / ARTWORK only
  deliveredById String?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@index([crfId, status])
}

model CrfOrder {
  id    String @id @default(uuid())
  crfId String @unique
  crf   CRF    @relation(fields: [crfId], references: [id], onDelete: Restrict)

  shopifyOrderId  String   @unique
  totalPrice      Decimal  @db.Decimal(12, 2)
  lines           Json                              // Shopify-confirmed snapshot: [{ sku, title, quantity, unitPrice, lineTotal }]
  debitNoteAmount Decimal? @db.Decimal(12, 2)        // set on the accept-partial path, and/or folded in from CRF.pendingDebitAmount at placement

  status        CrfOrderStatus @default(ACTIVE)
  cancelledAt   DateTime?
  cancelledById String?
  cancelReason  String?

  placedAt   DateTime @default(now())
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
}

model LineItem {
  id        String  @id @default(uuid())
  epfId     String?
  crfId     String?
  productId String

  quantity Decimal? @db.Decimal(10, 2)
  rate     Decimal? @db.Decimal(10, 2)
  amount   Decimal? @db.Decimal(12, 2)
  height   String?
  width    String?
  unit     String?

  // Proposer-typed note on this specific line (EPF overhead lines today).
  // Distinct from ProductMaster.description (the catalog item's generic
  // blurb) — this is what the proposer actually wrote for this line, and
  // takes priority over the catalog default when both exist (see
  // getDescription in epf.mapper.ts on the frontend). No length cap for
  // now — same as the other free-text fields on this model.
  description String?

  // One attachment (JPEG or PDF, ≤5MB, validated at the upload endpoint) per
  // line item. Key stored, not URL — see "S3 keys are stored, not URLs" in
  // decisions-and-learnings.md; a fresh pre-signed URL is generated on every
  // read via getSignedImageUrl, same convention as MedicalClaimBill.s3Key.
  attachmentS3Key    String?
  attachmentFileName String?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  epf     EPF?          @relation(fields: [epfId], references: [id], onDelete: Cascade)
  crf     CRF?          @relation(fields: [crfId], references: [id], onDelete: Cascade)
  product ProductMaster @relation(fields: [productId], references: [id])

  @@index([epfId])
  @@index([crfId])
}

model Comment {
  id         String   @id @default(uuid())
  message    String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  userId     String
  approvalId String?
  type       String   @default("COMMENT")
  workflowId String?

  user     User     @relation(fields: [userId], references: [id])
  approval Approval? @relation(fields: [approvalId], references: [id], onDelete: Cascade)
  workflow   WorkflowInstance? @relation(fields: [workflowId], references: [id], onDelete: Cascade)


  @@index([userId])
}

model Operator {
  id             Int               @id @default(autoincrement())
  name           String
  phone          String            @unique
  machineSerial  String
  operatorType   String
  submittedBy    String
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@index([machineSerial])         // look up operators by machine quickly
  @@index([submittedBy])           // look up all registrations a dealer submitted
}

model Lead {
  id             String   @id @default(uuid())
  epcId          String

  name           String   @db.VarChar(100)
  companyName    String?  @db.VarChar(150)
  phone          String?  @db.VarChar(15)
  email          String?  @db.VarChar(100)

  dealership     String?  @db.VarChar(150)

  participantType   ParticipantType?
  participantStatus ParticipantStatus?

  machineModel   String?  @db.VarChar(150)
  machineSerial  String?  @db.VarChar(100)

  valueOfServiceOffers Decimal? @db.Decimal(12, 2)
  valueOfPartsOffers   Decimal? @db.Decimal(12, 2)
  valueOfPartsBilled   Decimal? @db.Decimal(12, 2)

  notes          String?
  eventDate      DateTime?
  location       String?
  district       String?
  state          String?

  epc            EventProposal @relation(fields: [epcId], references: [id])
