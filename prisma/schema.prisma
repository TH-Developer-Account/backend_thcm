generator client {
  provider = "prisma-client"
  output   = "../src/prisma/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum PermissionAction {
  read
  write
}

model User {
  id            String       @id @default(uuid())
  first_name    String   @db.VarChar(50)
  last_name     String   @db.VarChar(50)
  email         String    @unique @db.VarChar(100)
  phone_number  String  @unique @db.VarChar(15)
  password      String    @db.VarChar(255)
  is_active     Boolean  @default(true)
  is_default_login  Boolean         @default(true) 
  refresh_tokens     RefreshToken[]
  password_reset_tokens  PasswordResetToken[] 
  appProfile UserAppProfile[]
  workspaces  WorkspaceUser[]
  created_event_proposals EventProposal[] @relation("EventCreatedBy")
  updated_event_proposals EventProposal[] @relation("EventUpdatedBy")

  created_at    DateTime @default(now()) @db.Timestamp(6)
  updated_at    DateTime @default(now()) @db.Timestamp(6)
}

model PasswordResetToken {
  id         String   @id @default(uuid())
  user_id    String
  user       User    @relation(fields: [user_id], references: [id], onDelete: Cascade)
  token      String   @unique @db.VarChar(255)
  expires_at DateTime
  used       Boolean  @default(false)
  created_at DateTime @default(now())
}

model RefreshToken {
  id        String   @id @default(uuid())
  token_id      String   @unique @db.VarChar(36) // UUID
  token_hash    String   @db.VarChar(255)
  token     String   @unique
  user_id    String
  user      User    @relation(fields: [user_id], references: [id], onDelete: Cascade)
  user_agent    String?
  ip_address    String?
  revoked       Boolean  @default(false)
  expires_at    DateTime
  created_at    DateTime @default(now())
}

// prisma/schema.prisma

model DailyVisitors {
  id          String   @id @default(uuid())
  date        DateTime @unique @db.Date
  total_visits Int     @default(0)
  created_at  DateTime @default(now())
  
  @@index([date])
}

model EventProposal {
  id               String      @id @default(uuid())
  proposal_number  String   @unique
  event_from_date       DateTime
  event_to_date       DateTime
  event_description String
  location String
  event_objective String
  status           String   @default("PENDING")
 
  created_by_id    String  
  updated_by_id    String
  department_id    String
  region_id        String
  branch_id        String
  event_scale_id   String
  budget_master_id String
  event_name_id    String

  department  Department  @relation(fields: [department_id], references: [id])
  region      Region      @relation(fields: [region_id], references: [id])
  branch      Branch      @relation(fields: [branch_id], references: [id])
  event_scale  EventScale  @relation(fields: [event_scale_id], references: [id])
  budget_master BudgetMaster @relation(fields: [budget_master_id], references: [id])
  event_name EventName @relation(fields: [event_name_id], references: [id])
  created_by User @relation("EventCreatedBy", fields: [created_by_id], references: [id])
  updated_by User @relation("EventUpdatedBy", fields: [updated_by_id], references: [id])
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  search_vector     Unsupported("tsvector")?

}


model Department {
  id              String    @id @default(uuid())
  department_code String   @unique
  department_name String
  event_proposals EventProposal[]
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

}


model Region {
  id           String     @id @default(uuid())
  region_code  String  @unique
  region_name  String
  event_proposals EventProposal[]
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
}


model Branch {
  id            String     @id @default(uuid())
  branch_code   String  @unique
  branch_name   String
  event_proposals EventProposal[]
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
}


model EventScale {
  id              String     @id @default(uuid())
  code      String  @unique
  title      String
  event_proposals EventProposal[]
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

}


model BudgetMaster {
  id             String      @id @default(uuid())
  fiscal_year String
  code   String
  id_desc String
  value Decimal
  event_proposals EventProposal[]
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

}


model EventName {
  id          String    @id @default(uuid())
  title String
  events      EventProposal[]
}

model Workspace {
  id    String              @id @default(uuid())
  name  String

  users WorkspaceUser[]
  apps  WorkspaceApp[]
  profile Profile[]
  userappprofile UserAppProfile[]
}

model WorkspaceUser {
  userId       String
  workspaceId  String
  isSuperAdmin Boolean @default(false)

  user      User      @relation(fields: [userId], references: [id])
  workspace Workspace @relation(fields: [workspaceId], references: [id])

  @@id([userId, workspaceId])
}

model App {
  id   String    @id @default(uuid())
  key  String @unique
  name String

  workspaces WorkspaceApp[]
  userProfile UserAppProfile[]
  module Module[]
}

model WorkspaceApp {
  workspaceId String
  appId       String
  enabled     Boolean @default(true)

  workspace Workspace @relation(fields: [workspaceId], references: [id])
  app       App       @relation(fields: [appId], references: [id])

  @@id([workspaceId, appId])
  @@unique([workspaceId, appId])
}

model Module {
  id     String @id @default(uuid())
  key    String
  name   String
  appId  String

  app App @relation(fields: [appId], references: [id])
 profile Profile[]
  @@unique([appId, key])
  @@index([appId])
}

model Profile {
  id          String  @id @default(uuid())
  workspaceId String
  moduleId    String?

  workspace Workspace @relation(fields: [workspaceId], references: [id])
  module    Module?   @relation(fields: [moduleId], references: [id])

  permissions ProfilePermission[]
  users       UserAppProfile[]

  @@unique([workspaceId, moduleId])
  @@index([workspaceId, moduleId])
}



model ProfilePermission {
  profileId     String
  permission PermissionAction 

  profile Profile @relation(fields: [profileId], references: [id])

  @@id([profileId, permission])
}

model UserAppProfile {
  userId String
  workspaceId String
  appId  String
  profileId String

  user User @relation(fields: [userId], references: [id])
  workspace Workspace @relation(fields: [workspaceId], references: [id])
  app  App  @relation(fields: [appId], references: [id])
  profile Profile @relation(fields: [profileId], references: [id])

  @@id([userId, workspaceId, appId])
  @@index([userId, workspaceId])
}





