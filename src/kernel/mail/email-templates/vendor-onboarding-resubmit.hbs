<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<title>Vendor Onboarding — Resubmitted</title>
	</head>

	<body
		style="margin:0; padding:0; background-color:#f4f4f5; font-family:Arial, Helvetica, sans-serif;"
	>
		<table
			role="presentation"
			width="100%"
			cellpadding="0"
			cellspacing="0"
			style="width:100%; background-color:#f4f4f5; padding:32px 12px;"
		>
			<tr>
				<td align="center">
					<table
						role="presentation"
						width="100%"
						cellpadding="0"
						cellspacing="0"
						style="width:100%; max-width:520px; background-color:#ffffff; border-radius:8px; overflow:hidden;"
					>
						<!-- Header -->
						<tr>
							<td style="background-color:#1a1a2e; padding:24px 32px;">
								<span
									style="color:#ffffff; font-size:18px; font-weight:bold; line-height:1.4;"
								>
									Tata Hitachi Construction Machinery
								</span>
							</td>
						</tr>

						<!-- Status indicator -->
						<tr>
							<td
								style="background-color:#eff6ff; padding:12px 32px; border-bottom:1px solid #bfdbfe;"
							>
								<table role="presentation" cellpadding="0" cellspacing="0">
									<tr>
										<td
											style="width:8px; height:8px; border-radius:50%; background-color:#2563eb;"
										></td>
										<td
											style="padding-left:8px; color:#1e40af; font-size:12px; font-weight:bold; text-transform:uppercase; letter-spacing:0.4px;"
										>
											Under review
										</td>
									</tr>
								</table>
							</td>
						</tr>

						<!-- Content -->
						<tr>
							<td style="padding:32px;">
								<h1
									style="margin:0 0 16px 0; color:#1a1a2e; font-size:20px; line-height:1.4;"
								>
									Your vendor onboarding form has been resubmitted
								</h1>

								<p
									style="margin:0 0 16px 0; color:#333333; font-size:14px; line-height:1.6;"
								>
									Dear
									{{vendorName}},
								</p>

								<p
									style="margin:0 0 20px 0; color:#333333; font-size:14px; line-height:1.6;"
								>
									Thank you for updating your vendor onboarding form. We've
									received your resubmission and it is now back with the Tata
									Hitachi Construction Machinery team for review. We'll notify
									you as soon as a decision has been made.
								</p>

								<!-- Resubmission summary -->
								<table
									role="presentation"
									width="100%"
									cellpadding="0"
									cellspacing="0"
									style="margin:0 0 24px 0; background-color:#eff6ff; border:1px solid #bfdbfe; border-left:4px solid #2563eb; border-radius:6px;"
								>
									<tr>
										<td style="padding:16px;">
											<p
												style="margin:0 0 8px 0; color:#1e40af; font-size:13px; font-weight:bold;"
											>
												Resubmission received
											</p>

											<p
												style="margin:0; color:#444444; font-size:13px; line-height:1.6; white-space:pre-line;"
											>
												Submitted on:
												{{resubmissionDate}}
											</p>
										</td>
									</tr>
								</table>

								<!-- CTA -->
								<table
									role="presentation"
									cellpadding="0"
									cellspacing="0"
									style="margin:0 0 24px 0;"
								>
									<tr>
										<td
											align="center"
											style="border-radius:6px; background-color:#2563eb;"
										>
											<a
												href="{{statusUrl}}"
												target="_blank"
												rel="noopener noreferrer"
												style="display:inline-block; padding:12px 28px; color:#ffffff; font-size:14px; font-weight:bold; text-decoration:none;"
											>
												View Application Status
											</a>
										</td>
									</tr>
								</table>

								<p
									style="margin:0 0 8px 0; color:#666666; font-size:12px; line-height:1.6;"
								>
									If the button does not work, copy and paste this link into
									your browser:
								</p>

								<p
									style="margin:0 0 24px 0; word-break:break-all; line-height:1.5;"
								>
									<a
										href="{{statusUrl}}"
										target="_blank"
										rel="noopener noreferrer"
										style="color:#2563eb; font-size:12px;"
									>
										{{statusUrl}}
									</a>
								</p>

								<table
									role="presentation"
									width="100%"
									cellpadding="0"
									cellspacing="0"
									style="border-top:1px solid #e5e7eb;"
								>
									<tr>
										<td style="padding-top:20px;">
											<p
												style="margin:0 0 8px 0; color:#666666; font-size:12px; line-height:1.6;"
											>
												This is a secure link intended only for the vendor
												associated with this onboarding request.
											</p>

											<p
												style="margin:0; color:#999999; font-size:12px; line-height:1.6;"
											>
												If you did not expect this email, please contact your
												Tata Hitachi representative.
											</p>
										</td>
									</tr>
								</table>
							</td>
						</tr>

						<!-- Footer -->
						<tr>
							<td
								style="background-color:#f4f4f5; padding:16px 32px; text-align:center;"
							>
								<p
									style="margin:0; color:#999999; font-size:11px; line-height:1.5;"
								>
									&copy;
									{{currentYear}}
									Tata Hitachi Construction Machinery. All rights reserved.
								</p>
							</td>
						</tr>
					</table>
				</td>
			</tr>
		</table>
	</body>
</html>