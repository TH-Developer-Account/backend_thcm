<div style="font-family: Arial, Helvetica, sans-serif; max-width: 560px">
  {{#if logoUrl}}<img src="{{logoUrl}}" alt="Logo" height="40" />{{/if}}
  <h2>Audit approved</h2>
  <p><strong>{{subjectLabel}}</strong></p>
  <p>The audit is complete. Score: <strong>{{score}}</strong> ({{percent}}%).</p>
