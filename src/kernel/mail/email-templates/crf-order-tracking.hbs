<h2
  style="margin:0 0 12px 0; font-size:16px; color:#000000; font-family:Arial,Helvetica,sans-serif;"
>Tracking available</h2>
<p
  style="margin:0 0 16px 0; font-size:13px; line-height:19px; color:#000000; font-family:Arial,Helvetica,sans-serif;"
>
  Your souvenir order now has tracking information. Please review the details
  below.
</p>
<table
  role="presentation"
  width="100%"
  cellpadding="0"
  cellspacing="0"
  style="width:100%; border-collapse:collapse; border:1px solid #e5e7eb; font-size:13px; line-height:19px; font-family:Arial,Helvetica,sans-serif;"
>
  <tr>
    <td
      class="kv-label"
      width="34%"
      valign="top"
      style="width:34%; padding:10px 12px; background-color:#f9fafb; color:#000000; font-weight:bold; vertical-align:top;"
    >Item</td>
    <td
      class="kv-value"
      width="66%"
      valign="top"
      style="width:66%; padding:10px 12px; color:#000000; vertical-align:top; word-break:break-word;"
    >{{subjectLabel}}</td>
  </tr>
  <tr>
    <td
      class="kv-label"
      width="34%"
      valign="top"
      style="width:34%; padding:10px 12px; background-color:#f9fafb; border-top:1px solid #e5e7eb; color:#000000; font-weight:bold; vertical-align:top;"
    >Shopify order</td>
    <td
      class="kv-value"
      width="66%"
      valign="top"
      style="width:66%; padding:10px 12px; border-top:1px solid #e5e7eb; color:#000000; vertical-align:top; word-break:break-word;"
    >{{shopifyOrderId}}</td>
  </tr>
  <tr>
    <td
      class="kv-label"
      width="34%"
      valign="top"
      style="width:34%; padding:10px 12px; background-color:#f9fafb; border-top:1px solid #e5e7eb; color:#000000; font-weight:bold; vertical-align:top;"
    >Tracking ID</td>
    <td
      class="kv-value"
      width="66%"
      valign="top"
      style="width:66%; padding:10px 12px; border-top:1px solid #e5e7eb; color:#000000; vertical-align:top; word-break:break-word;"
    >{{trackingId}}</td>
  </tr>
  <tr>
    <td
      class="kv-label"
      width="34%"
      valign="top"
      style="width:34%; padding:10px 12px; background-color:#f9fafb; border-top:1px solid #e5e7eb; color:#000000; font-weight:bold; vertical-align:top;"
    >Track shipment</td>
    <td
      class="kv-value"
      width="66%"
      valign="top"
      style="width:66%; padding:10px 12px; border-top:1px solid #e5e7eb; color:#000000; vertical-align:top; word-break:break-word;"
    >
      <a href="{{trackingUrl}}" style="color:#f36f21;">{{trackingUrl}}</a>
    </td>
  </tr>
</table>
<table
  role="presentation"
  width="100%"
  cellpadding="0"
  cellspacing="0"
  style="width:100%; margin-top:20px;"
>
  <tr><td align="left">
      <a
        class="btn"
        href="{{dashboardUrl}}"
        target="_blank"
        rel="noopener noreferrer"
        style="display:block; width:100%; box-sizing:border-box; background-color:#f36f21; border-radius:4px; color:#ffffff; font-family:Arial,Helvetica,sans-serif; font-size:14px; font-weight:bold; line-height:44px; padding:0 16px; text-align:center; text-decoration:none;"
      >View CRF</a>
    </td></tr>
</table>