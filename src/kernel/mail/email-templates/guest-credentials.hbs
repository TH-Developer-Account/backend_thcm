<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Your Guest Portal Login</title>
  </head>
  <body
    style="margin:0; padding:0; background-color:#f4f4f5; font-family: Arial, Helvetica, sans-serif;"
  >
    <table
      role="presentation"
      width="100%"
      cellpadding="0"
      cellspacing="0"
      style="background-color:#f4f4f5; padding:32px 0;"
    >
      <tr>
        <td align="center">
          <table
            role="presentation"
            width="480"
            cellpadding="0"
            cellspacing="0"
            style="background-color:#ffffff; border-radius:8px; overflow:hidden;"
          >
            <tr>
              <td style="background-color:#1a1a2e; padding:24px 32px;">
                <span
                  style="color:#ffffff; font-size:18px; font-weight:bold;"
                >Tata Hitachi Construction Machinery</span>
              </td>
            </tr>
            <tr>
              <td style="padding:32px;">
                <h2 style="margin:0 0 16px 0; color:#1a1a2e; font-size:20px;">
                  Your Guest Portal Login
                </h2>

                <p
                  style="margin:0 0 16px 0; color:#333333; font-size:14px; line-height:1.6;"
                >
                  Hello,
                </p>

                <p
                  style="margin:0 0 16px 0; color:#333333; font-size:14px; line-height:1.6;"
                >
                  An account has been set up for you so you can log back in at
                  any time to check the status of your submission and view
                  everything you've submitted. Here are your login details:
                </p>

                <table
                  role="presentation"
                  width="100%"
                  cellpadding="0"
                  cellspacing="0"
                  style="margin:0 0 24px 0; background-color:#f4f4f5; border-radius:6px;"
                >
                  <tr>
                    <td style="padding:16px 20px;">
                      <p
                        style="margin:0 0 8px 0; color:#333333; font-size:14px; line-height:1.5;"
                      >
                        <strong>Email:</strong>
                        {{email}}
                      </p>
                      <p
                        style="margin:0; color:#333333; font-size:14px; line-height:1.5;"
                      >
                        <strong>Password:</strong>
                        {{password}}
                      </p>
                    </td>
                  </tr>
                </table>

                <table
                  role="presentation"
                  cellpadding="0"
                  cellspacing="0"
                  style="margin:0 0 24px 0;"
                >
                  <tr>
                    <td
                      align="center"
                      style="border-radius:6px; background-color:#e85d04;"
                    >
                      <a
                        href="{{loginUrl}}"
                        target="_blank"
                        style="display:inline-block; padding:12px 28px; color:#ffffff; font-size:14px; font-weight:bold; text-decoration:none;"
                      >
                        Log In
                      </a>
                    </td>
                  </tr>
                </table>

                <p
                  style="margin:0 0 8px 0; color:#666666; font-size:12px; line-height:1.6;"
                >
                  If the button above doesn't work, copy and paste this link
                  into your browser:
                </p>
                <p style="margin:0 0 24px 0; word-break:break-all;">
                  <a
                    href="{{loginUrl}}"
                    style="color:#e85d04; font-size:12px;"
                  >{{loginUrl}}</a>
                </p>

                <p
                  style="margin:0 0 8px 0; color:#999999; font-size:12px; line-height:1.6;"
                >
                  For security, please avoid sharing this email or password
                  with anyone. If you did not expect this email, you can
                  safely ignore it.
                </p>
              </td>
            </tr>
            <tr>
              <td
                style="background-color:#f4f4f5; padding:16px 32px; text-align:center;"
              >
                <p style="margin:0; color:#999999; font-size:11px;">
                  &copy;
                  {{currentYear}}
                  Tata Hitachi Construction Machinery. All rights reserved.
                </p>
              </td>
            </tr>
          </table>
        </td>
      </tr>
    </table>
  </body>
</html>
