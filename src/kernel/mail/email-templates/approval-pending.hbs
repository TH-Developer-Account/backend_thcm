<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <title>{{subject}}</title>
    <style>
      body {
        margin: 0;
        padding: 0;
        background-color: #f4f4f7;
        font-family: Arial, sans-serif;
        color: #333;
      }
      .wrapper {
        width: 100%;
        max-width: 600px;
        margin: 32px auto;
        background: #fff;
        border-radius: 8px;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08);
        overflow: hidden;
      }
      .header {
        background-color: #1a56db;
        padding: 24px 32px;
      }
      .header h1 {
        margin: 0;
        color: #fff;
        font-size: 20px;
        font-weight: 600;
      }
      .content {
        padding: 32px;
      }
      .footer {
        background-color: #f4f4f7;
        padding: 16px 32px;
        text-align: center;
        font-size: 12px;
        color: #888;
      }
      table {
        width: 100%;
        border-collapse: collapse;
        margin: 24px 0;
        font-size: 14px;
      }
      td {
        padding: 10px 14px;
        border: 1px solid #e5e7eb;
      }
    </style>
  </head>
  <body>
    <div class="wrapper">

      <div class="header">
        <h1>{{appName}}</h1>
      </div>

      <div class="content">
        <p style="font-size: 16px; margin-top: 0;">
          Hello
          <strong>{{approverName}}</strong>,
        </p>
        <p style="font-size: 14px; line-height: 1.6;">
          <strong>{{subjectLabel}}</strong>
          is now waiting on your approval.
        </p>

        <table>
          <tr style="background-color: #f9fafb;">
            <td style="font-weight: 600; width: 40%;">Item</td>
            <td>{{subjectLabel}}</td>
          </tr>
          <tr>
            <td style="font-weight: 600;">Stage</td>
            <td>{{stageName}}</td>
          </tr>
          <tr style="background-color: #f9fafb;">
            <td style="font-weight: 600;">Status</td>
            <td><span style="color: #b45309; font-weight: 600;">Pending your
                approval</span></td>
          </tr>
        </table>

        <p style="text-align: center; margin: 32px 0;">
          <a
            href="{{dashboardUrl}}"
            style="background-color: #1a56db; color: #fff; padding: 12px 24px;
                    border-radius: 6px; text-decoration: none; font-size: 14px; font-weight: 600;"
          >
            Review Now
          </a>
        </p>
      </div>

      <div class="footer">
        &copy;
        {{currentYear}}
        {{appName}}. All rights reserved.<br />
        This is an automated message — please do not reply.
      </div>

    </div>
  </body>
</html>