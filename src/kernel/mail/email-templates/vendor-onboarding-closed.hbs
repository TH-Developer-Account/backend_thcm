<html
	lang="en"
	xmlns="http://www.w3.org/1999/xhtml"
	xmlns:v="urn:schemas-microsoft-com:vml"
	xmlns:o="urn:schemas-microsoft-com:office:office"
>
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<meta http-equiv="X-UA-Compatible" content="IE=edge" />
		<meta name="color-scheme" content="light" />
		<meta name="supported-color-schemes" content="light" />
		<meta
			name="format-detection"
			content="telephone=no, date=no, address=no, email=no"
		/>
		<title>Completed</title>
		<!--[if mso]>
<noscript><xml><o:OfficeDocumentSettings><o:PixelsPerInch>96</o:PixelsPerInch></o:OfficeDocumentSettings></xml></noscript>
<style>table, td, div, p, a { font-family: Arial, Helvetica, sans-serif !important; }</style>
<![endif]-->
		<style>
			body,
			table,
			td,
			a {
				-webkit-text-size-adjust: 100%;
				-ms-text-size-adjust: 100%;
			}
			table,
			td {
				mso-table-lspace: 0pt;
				mso-table-rspace: 0pt;
			}
			body {
				margin: 0;
				padding: 0;
				width: 100% !important;
				background-color: #f3f4f6;
			}
			a[x-apple-data-detectors] {
				color: inherit !important;
				text-decoration: none !important;
			}
			/* Layout is fluid by default (100% width, 16px padding, full-width button). Media queries only refine it. */
			@media only screen and (max-width: 600px) {
				.kv-label,
				.kv-value {
					display: block !important;
					width: 100% !important;
					box-sizing: border-box !important;
				}
				.kv-label {
					padding-bottom: 2px !important;
					border-bottom: 0 !important;
				}
				.kv-value {
					border-top: 0 !important;
					padding-top: 0 !important;
				}
			}
			@media only screen and (min-width: 601px) {
				.outer {
					padding: 16px 8px !important;
				}
				.pad {
					padding-left: 24px !important;
					padding-right: 24px !important;
				}
				.btn {
					display: inline-block !important;
					width: auto !important;
					padding-left: 24px !important;
					padding-right: 24px !important;
				}
			}
		</style>
	</head>
	<body style="margin:0; padding:0; background-color:#f3f4f6;">
		<div
			style="display:none; max-height:0; overflow:hidden; mso-hide:all; font-size:1px; line-height:1px; color:#f3f4f6;"
		>
			Your vendor onboarding request has been
			completed&nbsp;&zwnj;&nbsp;&zwnj;&nbsp;&zwnj;&nbsp;&zwnj;&nbsp;&zwnj;
		</div>
		<table
			role="presentation"
			width="100%"
			cellpadding="0"
			cellspacing="0"
			style="background-color:#f3f4f6;"
		>
			<tr><td align="center" class="outer" style="padding:0;">
					<!--[if mso]><table role="presentation" width="600" cellpadding="0" cellspacing="0" align="center"><tr><td><![endif]-->
					<table
						role="presentation"
						width="100%"
						cellpadding="0"
						cellspacing="0"
						class="container"
						style="width:100%; max-width:600px; background-color:#ffffff; border:1px solid #e5e7eb; border-radius:4px;"
					>
						<!-- Logo & branding -->
						<tr>
							<td
								class="pad"
								style="padding:6px 16px; border-bottom:1px solid #e5e7eb; font-family:Arial,Helvetica,sans-serif;"
							>
								{{#if logoUrl}}
									<img
										src="{{logoUrl}}"
										width="120"
										alt="Tata Hitachi Construction Machinery"
										style="display:block; border:0; width:120px; max-width:100%; height:auto; font-size:16px; font-weight:bold; color:#000000;"
									/>
								{{else}}
									<table role="presentation" cellpadding="0" cellspacing="0"><tr
										>
											<td style="padding-right:10px;">
												<table
													role="presentation"
													cellpadding="0"
													cellspacing="0"
												><tr>
														<td
															width="32"
															height="32"
															align="center"
															style="width:32px; height:32px; background-color:#f36f21; border-radius:4px; color:#ffffff; font-size:13px; font-weight:bold; font-family:Arial,Helvetica,sans-serif;"
														>TH</td>
													</tr></table>
											</td>
											<td
												style="color:#000000; font-size:16px; line-height:20px; font-weight:bold; font-family:Arial,Helvetica,sans-serif;"
											>Tata Hitachi Construction Machinery</td>
										</tr></table>
								{{/if}}
							</td>
						</tr>
						<!-- Content -->
						<tr>
							<td
								class="pad"
								style="padding:16px; font-family:Arial,Helvetica,sans-serif; color:#000000;"
							>
								<p
									style="margin:0 0 8px 0; font-size:14px; line-height:21px; color:#000000;"
								>Dear Sir/Madam,</p>
								<p
									style="margin:0 0 16px 0; font-size:14px; line-height:21px; color:#000000;"
								>The vendor onboarding request you initiated has been fully
									approved and closed. No further action is required.</p>
								<table
									role="presentation"
									width="100%"
									cellpadding="0"
									cellspacing="0"
									style="width:100%; border-collapse:collapse; border:1px solid #e5e7eb; font-size:13px; line-height:19px; font-family:Arial,Helvetica,sans-serif;"
								>
									<tr>
										<td
											class="kv-label"
											width="34%"
											valign="top"
											style="width:34%; padding:10px 12px; background-color:#f9fafb; color:#000000; font-weight:bold; vertical-align:top;"
										>Vendor Name</td>
										<td
											class="kv-value"
											width="66%"
											valign="top"
											style="width:66%; padding:10px 12px; color:#000000; vertical-align:top; word-break:break-word;"
										><strong>{{vendorName}}</strong></td>
									</tr>
									<tr>
										<td
											class="kv-label"
											width="34%"
											valign="top"
											style="width:34%; padding:10px 12px; background-color:#f9fafb; border-top:1px solid #e5e7eb; color:#000000; font-weight:bold; vertical-align:top;"
										>Vendor Code</td>
										<td
											class="kv-value"
											width="66%"
											valign="top"
											style="width:66%; padding:10px 12px; border-top:1px solid #e5e7eb; color:#000000; vertical-align:top; word-break:break-word;"
										>{{vendorCode}}</td>
									</tr>
									<tr>
										<td
											class="kv-label"
											width="34%"
											valign="top"
											style="width:34%; padding:10px 12px; background-color:#f9fafb; border-top:1px solid #e5e7eb; color:#000000; font-weight:bold; vertical-align:top;"
										>Reference No.</td>
										<td
											class="kv-value"
											width="66%"
											valign="top"
											style="width:66%; padding:10px 12px; border-top:1px solid #e5e7eb; color:#000000; vertical-align:top; word-break:break-word;"
										>{{referenceNumber}}</td>
									</tr>
									<tr>
										<td
											class="kv-label"
											width="34%"
											valign="top"
											style="width:34%; padding:10px 12px; background-color:#f9fafb; border-top:1px solid #e5e7eb; color:#000000; font-weight:bold; vertical-align:top;"
										>Status</td>
										<td
											class="kv-value"
											width="66%"
											valign="top"
											style="width:66%; padding:10px 12px; border-top:1px solid #e5e7eb; color:#000000; vertical-align:top; word-break:break-word;"
										><table
												role="presentation"
												cellpadding="0"
												cellspacing="0"
											><tr><td
														style="padding:2px 8px; background-color:#f3f4f6; border:1px solid #d1d5db; border-radius:3px; color:#000000; font-size:12px; line-height:18px; font-weight:bold; white-space:nowrap;"
													>Completed</td></tr></table></td>
									</tr>
								</table>

							</td>
						</tr>
						<!-- Footer -->
						<tr>
							<td
								class="pad"
								style="padding:12px 16px; border-top:1px solid #e5e7eb; background-color:#fafafa; font-family:Arial,Helvetica,sans-serif;"
							>
								<p
									style="margin:0; font-size:11px; line-height:17px; color:#000000;"
								>This is an automated message. Please do not reply.</p>
							</td>
						</tr>
					</table>
					<!--[if mso]></td></tr></table><![endif]-->
				</td></tr>
		</table>
	</body>
</html>