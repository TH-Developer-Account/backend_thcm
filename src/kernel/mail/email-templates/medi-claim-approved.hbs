<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<title>Medical Claim Submitted Successfully</title>
	</head>
	<body
		style="margin:0; padding:0; background-color:#f4f4f5; font-family:Arial, Helvetica, sans-serif;"
	>
		<table
			role="presentation"
			width="100%"
			cellpadding="0"
			cellspacing="0"
			style="background-color:#f4f4f5; padding:32px 0;"
		>
			<tr><td align="center">
					<table
						role="presentation"
						width="480"
						cellpadding="0"
						cellspacing="0"
						style="width:100%; max-width:480px; background-color:#ffffff; border-radius:8px; overflow:hidden;"
					>
						<tr><td style="background-color:#1a1a2e; padding:24px 32px;"><span
									style="color:#ffffff; font-size:18px; font-weight:bold;"
								>Tata Hitachi Construction Machinery</span></td></tr>
						<tr><td style="padding:32px;">
								<div
									style="width:44px; height:44px; line-height:44px; border-radius:50%; background-color:#dcfce7; color:#166534; text-align:center; font-size:24px; font-weight:bold; margin:0 0 20px;"
								>&#10003;</div>
								<h2
									style="margin:0 0 16px; color:#1a1a2e; font-size:20px;"
								>Medical Claim Submitted Successfully</h2>
								<p
									style="margin:0 0 16px; color:#333333; font-size:14px; line-height:1.6;"
								>Dear <strong>{{employeeName}}</strong>,</p>
								<p
									style="margin:0 0 16px; color:#333333; font-size:14px; line-height:1.6;"
								>Your medical reimbursement claim has been submitted
									successfully and will now be reviewed by Tata Hitachi.</p>
								<table
									role="presentation"
									width="100%"
									cellpadding="0"
									cellspacing="0"
									style="margin:20px 0 24px;"
								><tr><td
											style="background-color:#f0fdf4; border:1px solid #86efac; border-radius:6px; padding:14px 16px; color:#166534; font-size:13px; line-height:1.6;"
										><strong>Submission completed</strong><br />Claim reference:
											<strong>{{claimReference}}</strong><br />Submitted on:
											<strong>{{submittedAt}}</strong></td></tr></table>
								<p
									style="margin:0 0 16px; color:#333333; font-size:14px; line-height:1.6;"
								><strong>No further action is required from you at this time.</strong>
									You will be contacted if any clarification or additional
									information is needed.</p>
								<p
									style="margin:0; color:#999999; font-size:12px; line-height:1.6;"
								>For your security, the form link used for this submission is
									now invalid.</p>
							</td></tr>
						<tr><td
								style="background-color:#f4f4f5; padding:16px 32px; text-align:center;"
							><p style="margin:0; color:#999999; font-size:11px;">&copy;
									{{currentYear}}
									Tata Hitachi Construction Machinery. All rights reserved.</p></td></tr>
					</table>
				</td></tr>
		</table>
	</body>
</html>