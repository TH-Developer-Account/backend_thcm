<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Vendor Onboarding — Submission Received</title>
  </head>
  <body
    style="margin:0; padding:0; background-color:#f4f4f5; font-family: Arial, Helvetica, sans-serif;"
  >
    <table
      role="presentation"
      width="100%"
      cellpadding="0"
      cellspacing="0"
      style="background-color:#f4f4f5; padding:32px 0;"
    >
      <tr>
        <td align="center">
          <table
            role="presentation"
            width="480"
            cellpadding="0"
            cellspacing="0"
            style="background-color:#ffffff; border-radius:8px; overflow:hidden;"
          >
            <tr>
              <td style="background-color:#1a1a2e; padding:24px 32px;">
                <span
                  style="color:#ffffff; font-size:18px; font-weight:bold;"
                >Tata Hitachi Construction Machinery</span>
              </td>
            </tr>
            <tr>
              <td style="padding:32px;">
                <h2 style="margin:0 0 16px 0; color:#1a1a2e; font-size:20px;">
                  Vendor Onboarding — Submission Received
                </h2>

                <p
                  style="margin:0 0 16px 0; color:#333333; font-size:14px; line-height:1.6;"
                >
                  Dear
                  {{vendorName}},
                </p>

                <p
                  style="margin:0 0 16px 0; color:#333333; font-size:14px; line-height:1.6;"
                >
                  Thank you for submitting your vendor onboarding details with
                  Tata Hitachi Construction Machinery. Your submission
                  {{#if referenceNumber}}(Reference No.
                    <strong>{{referenceNumber}}</strong>)
                  {{/if}}
                  has been received and is now under review.
                </p>

                <p
                  style="margin:0 0 16px 0; color:#333333; font-size:14px; line-height:1.6;"
                >
                  You can view or download a copy of your submitted details as a
                  PDF using the button below.
                </p>

                <table
                  role="presentation"
                  cellpadding="0"
                  cellspacing="0"
                  style="margin:24px 0;"
                >
                  <tr>
                    <td
                      align="center"
                      style="border-radius:6px; background-color:#e85d04;"
                    >
                      <a
                        href="{{pdfViewUrl}}"
                        target="_blank"
                        style="display:inline-block; padding:12px 28px; color:#ffffff; font-size:14px; font-weight:bold; text-decoration:none;"
                      >
                        View / Download PDF
                      </a>
                    </td>
                  </tr>
                </table>

                <p
                  style="margin:0 0 8px 0; color:#666666; font-size:12px; line-height:1.6;"
                >
                  If the button above doesn't work, copy and paste this link
                  into your browser:
                </p>
                <p style="margin:0 0 24px 0; word-break:break-all;">
                  <a
                    href="{{pdfViewUrl}}"
                    style="color:#e85d04; font-size:12px;"
                  >{{pdfViewUrl}}</a>
                </p>

                <p
                  style="margin:0 0 8px 0; color:#999999; font-size:12px; line-height:1.6;"
                >
                  This link stays valid for as long as your onboarding record
                  exists, so you can revisit it any time. If you did not expect
                  this email, you can safely ignore it.
                </p>
              </td>
            </tr>
            <tr>
              <td
                style="background-color:#f4f4f5; padding:16px 32px; text-align:center;"
              >
                <p style="margin:0; color:#999999; font-size:11px;">
                  &copy;
                  {{currentYear}}
                  Tata Hitachi Construction Machinery. All rights reserved.
                </p>
              </td>
            </tr>
          </table>
        </td>
      </tr>
    </table>
  </body>
</html>